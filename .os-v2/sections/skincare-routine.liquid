{{ 'skincare-pdp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign routine_heading = section.settings.heading
  if routine_heading == blank
    assign routine_heading = 'products.skincare.routine_heading' | t: product: product.title
  endif
  assign explore_prefix = section.settings.explore_prefix
-%}

<section class="ge-skin-routine" aria-labelledby="SkinRoutine-{{ section.id }}">
  <div class="ge-skin-routine__inner">
    <h2 class="ge-skin-routine__title" id="SkinRoutine-{{ section.id }}">{{ routine_heading | escape }}</h2>
    <ol class="ge-skin-routine__steps">
      {%- for block in section.blocks -%}
        {%- liquid
          assign step_name = block.settings.name
          assign step_url = block.settings.link
          if block.settings.product != blank
            assign step_name = block.settings.product.title
            assign step_url = block.settings.product.url
          endif
          if step_name == blank
            assign step_name = product.title
          endif
        -%}
        <li class="ge-skin-routine__step{% if block.settings.current %} ge-skin-routine__step--current{% endif %}" {{ block.shopify_attributes }}>
          <span class="ge-skin-routine__node" aria-hidden="true"></span>
          <p class="ge-skin-routine__label">{{ block.settings.label | escape }}</p>
          <p class="ge-skin-routine__name">
            {%- if step_url != blank -%}
              <a href="{{ step_url }}">
                {%- unless block.settings.current -%}
                  {%- if explore_prefix != blank -%}{{ explore_prefix | escape }} {% endif -%}
                {%- endunless -%}
                {{ step_name | escape }}
              </a>
            {%- else -%}
              {%- unless block.settings.current -%}
                {%- if explore_prefix != blank -%}{{ explore_prefix | escape }} {% endif -%}
              {%- endunless -%}
              {{ step_name | escape }}
            {%- endif -%}
          </p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Skincare routine",
  "tag": "section",
  "class": "section-skincare-routine",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the product title."
    },
    {
      "type": "text",
      "id": "explore_prefix",
      "label": "Link prefix",
      "default": "Explore"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Step label",
          "default": "Step 1: Cleanse"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "info": "Used when no product is selected."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Used when no product is selected."
        },
        {
          "type": "checkbox",
          "id": "current",
          "label": "This is the current product",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Skincare routine",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "label": "Step 1: Cleanse",
            "name": "Pink Dew Gel Cleanser"
          }
        },
        {
          "type": "step",
          "settings": {
            "label": "Step 2: Treat",
            "name": "CC Me Serum"
          }
        },
        {
          "type": "step",
          "settings": {
            "label": "Step 3: Moisturize",
            "name": "Cloud Dew Gel Cream Moisturizer"
          }
        },
        {
          "type": "step",
          "settings": {
            "label": "Step 4: Protect",
            "name": "ShadeDrops Mineral Milk Sunscreen",
            "current": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
