{{ 'image-with-text.css' | asset_url | stylesheet_tag }}
{{ 'skincare-pdp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign story = product.metafields.custom.why_we_made_it.value | strip
  assign story_image = section.settings.image
  if story_image == blank
    assign story_image = product.featured_image
  endif
  assign story_alt = section.settings.image_alt
  if story_alt == blank and story_image != blank
    assign story_alt = story_image.alt
  endif
-%}

{%- if story != blank or section.settings.heading != blank -%}
  <div class="row full-width-row">
    <div class="small-12 columns">
      <div class="image-with-text ge-skin-split ge-skin-story grid--image-medium">
        <div class="image-with-text__content image-with-text__inner">
          <div class="image-with-text__content--inner">
            {%- if section.settings.eyebrow != blank -%}
              <p class="sr-beta__eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2 class="sr-beta__title">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if story != blank -%}
              <div class="sr-beta__lede rte">{{ story | escape | newline_to_br }}</div>
            {%- endif -%}
            {%- if section.settings.support != blank -%}
              <p class="ge-skin-story__support">{{ section.settings.support | escape }}</p>
            {%- endif -%}
          </div>
        </div>
        <div class="image-with-text__image image-with-text__inner">
          <div class="image-with-text__image-media aspect-ratio aspect-ratio--adapt" style="--ratio-percent: 125%;">
            {%- if story_image != blank -%}
              {{
                story_image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 768px) 50vw, 100vw',
                  widths: '600, 900, 1400, 1600',
                  alt: story_alt
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder_svg_tag' }}
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Skincare editorial",
  "tag": "section",
  "class": "section-skincare-editorial",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why we made it"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One last good thing before bed."
    },
    {
      "type": "text",
      "id": "support",
      "label": "Supporting line",
      "info": "Optional. Shown once under the product story."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave blank to use the product photo until the evening shoot is ready."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description",
      "info": "Write this from the photograph itself. Leave blank to use the image alt text."
    }
  ],
  "presets": [{ "name": "Skincare editorial" }]
}
{% endschema %}
