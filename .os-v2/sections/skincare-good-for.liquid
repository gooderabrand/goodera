{{ 'skincare-pdp.css' | asset_url | stylesheet_tag }}

<div class="ge-skin-good">
  <div class="ge-skin-good__intro">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p>{{ section.settings.intro | escape }}</p>
    {%- endif -%}
  </div>
  <ul class="ge-skin-good__grid">
    {%- for block in section.blocks -%}
      <li class="ge-skin-good__card" {{ block.shopify_attributes }}>
        <span class="ge-skin-good__icon" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'shield' -%}
              <svg viewBox="0 0 24 24" width="22" height="22"><path d="M12 3.5 19 6.2v5.4c0 4.2-2.8 7.2-7 8.9-4.2-1.7-7-4.7-7-8.9V6.2L12 3.5Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
            {%- when 'spark' -%}
              <svg viewBox="0 0 24 24" width="22" height="22"><path d="M12 3.5 13.4 9 19 10.5 13.4 12 12 17.5 10.6 12 5 10.5 10.6 9 12 3.5Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" width="22" height="22"><path d="M12 4.2c2.6 2.4 4.2 4.6 4.2 7.2a4.2 4.2 0 1 1-8.4 0c0-2.6 1.6-4.8 4.2-7.2Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
          {%- endcase -%}
        </span>
        {%- if block.settings.title != blank -%}
          <h3>{{ block.settings.title | escape }}</h3>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <p>{{ block.settings.text | escape }}</p>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Skincare benefit cards",
  "tag": "section",
  "class": "section-skincare-good-for",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What it's good for"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Power up your beauty sleep with moisture-binding ingredients and softening squalane."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "droplet",
          "options": [
            { "value": "droplet", "label": "Droplet" },
            { "value": "shield", "label": "Shield" },
            { "value": "spark", "label": "Spark" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Replenish your moisture." },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Skincare benefit cards" }]
}
{% endschema %}
