{% doc %}
  Renders skincare specification rows from product metafields.
  Format, size, pack contents, and routine placement each appear only when that field has a value.
  @param {product} product - Product whose specifications are shown
  @example
  {% render 'skincare-specs', product: product %}
{% enddoc %}

{%- liquid
  assign format_label = product.metafields.descriptors.subtitle.value | strip
  assign size_label = product.metafields.custom.size_label.value | strip
  assign inside = product.metafields.custom.whats_inside.value | strip
  assign routine = product.metafields.custom.ritual_moment.value | strip
-%}

{%- if format_label != blank or size_label != blank or inside != blank or routine != blank -%}
  {{ 'skincare-pdp.css' | asset_url | stylesheet_tag }}
  <dl class="ge-skin-specs">
    {%- if format_label != blank -%}
      <div class="ge-skin-specs__row">
        <dt>Format</dt>
        <dd>{{ format_label | escape }}</dd>
      </div>
    {%- endif -%}
    {%- if size_label != blank -%}
      <div class="ge-skin-specs__row">
        <dt>Size</dt>
        <dd>{{ size_label | escape }}</dd>
      </div>
    {%- endif -%}
    {%- if inside != blank -%}
      <div class="ge-skin-specs__row">
        <dt>What's inside</dt>
        <dd>{{ inside | escape }}</dd>
      </div>
    {%- endif -%}
    {%- if routine != blank -%}
      <div class="ge-skin-specs__row">
        <dt>Routine</dt>
        <dd>{{ routine | escape }}</dd>
      </div>
    {%- endif -%}
  </dl>
{%- endif -%}
