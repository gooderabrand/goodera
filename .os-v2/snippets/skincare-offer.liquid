{% doc %}
  Buy One and optional two-unit cards for the skincare buy box.
  The selected card sets the product form quantity. There is no separate stepper.
  Prices are the selected variant price, doubled for the two-unit card. No savings line is shown.
  A card can still be selected while the variant is sold out, so the bag price follows the click. The add-to-bag button stays sold out. A card is disabled only when that quantity cannot be bought and another quantity can.
  @param {product} product - Product being purchased
  @param {block} block - Theme editor block with the card labels
  @param {section} section - Product section, used for the form id
  @example
  {% render 'skincare-offer', product: product, block: block, section: section %}
{% enddoc %}

{{ 'skincare-pdp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign variant = product.selected_variant
  if variant == blank
    assign variant = product.selected_or_first_available_variant
  endif
  if product.handle == 'sunday-reset-overnight-glow-mask'
    for candidate in product.variants
      assign candidate_title = candidate.title | downcase | strip
      if candidate_title == '50 ml'
        assign variant = candidate
        break
      endif
    endfor
  endif
  assign unit_price = variant.price
  assign pair_price = unit_price | times: 2
  assign product_form_id = 'product-form-' | append: section.id
  assign is_kit = false
  if product.handle == 'sunday-reset-ritual-kit'
    assign is_kit = true
  endif
  if is_kit
    assign one_title = block.settings.kit_one_title
    assign one_detail = block.settings.kit_one_detail
    assign one_volume = block.settings.kit_one_volume | default: '8 mL | 0.28 fl oz'
    assign bundle_title = block.settings.kit_bundle_title
    assign bundle_detail = block.settings.kit_bundle_detail
    assign bundle_volume = block.settings.kit_bundle_volume | default: '16 mL | 0.56 fl oz'
    assign bundle_badge = block.settings.kit_badge
  else
    assign one_title = block.settings.mask_one_title
    assign one_detail = block.settings.mask_one_detail
    assign one_volume = block.settings.mask_one_volume | default: '50 mL | 1.69 fl oz'
    assign bundle_title = block.settings.mask_bundle_title
    assign bundle_detail = block.settings.mask_bundle_detail
    assign bundle_volume = block.settings.mask_bundle_volume | default: '100 mL | 3.38 fl oz'
    assign bundle_badge = block.settings.mask_badge
  endif
  assign show_bundle = block.settings.show_bundle
  assign two_buy = false
  assign one_select = true
  assign two_select = true
  if variant.available
    assign two_buy = true
    if variant.quantity_rule.max != blank and variant.quantity_rule.max < 1
      assign one_select = false
    endif
    if variant.quantity_rule.max != blank and variant.quantity_rule.max < 2
      assign two_buy = false
      assign two_select = false
    endif
    if variant.inventory_management != blank and variant.inventory_policy != 'continue'
      if variant.inventory_quantity < 1
        assign one_select = false
      endif
      if variant.inventory_quantity < 2
        assign two_buy = false
        assign two_select = false
      endif
    endif
  endif
-%}

{%- capture offer_stock -%}
[
{%- for offer_variant in product.variants -%}
  {%- liquid
    assign stock_one = false
    assign stock_two = false
    if offer_variant.available
      assign stock_one = true
      assign stock_two = true
      if offer_variant.quantity_rule.max != blank and offer_variant.quantity_rule.max < 1
        assign stock_one = false
      endif
      if offer_variant.quantity_rule.max != blank and offer_variant.quantity_rule.max < 2
        assign stock_two = false
      endif
      if offer_variant.inventory_management != blank and offer_variant.inventory_policy != 'continue'
        if offer_variant.inventory_quantity < 1
          assign stock_one = false
        endif
        if offer_variant.inventory_quantity < 2
          assign stock_two = false
        endif
      endif
    endif
  -%}
  {"id":{{ offer_variant.id }},"one":{{ stock_one }},"two":{{ stock_two }},"priceOne":{{ offer_variant.price | money | json }},"priceTwo":{{ offer_variant.price | times: 2 | money | json }}}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
{%- endcapture -%}

<div
  class="ge-skin-offers"
  data-ge-offers
  data-section="{{ section.id }}"
  data-price-one="{{ unit_price | money | escape }}"
  data-price-two="{{ pair_price | money | escape }}"
  {{ block.shopify_attributes }}
>
  <div class="ge-skin-offers__grid" role="radiogroup" aria-label="Purchase options">
    <label class="ge-skin-offer{% if one_select %} is-selected{% else %} is-unavailable{% endif %}" data-qty="1"{% unless one_select %} aria-disabled="true"{% endunless %}>
      <input type="radio" name="ge-offer-{{ section.id }}" value="1"{% if one_select %} checked{% endif %}{% unless one_select %} disabled{% endunless %}>
      <span class="ge-skin-offer__copy">
        <span class="ge-skin-offer__name">{{ one_title | escape }}</span>
        {%- if one_detail != blank or one_volume != blank -%}
          <span class="ge-skin-offer__meta">
            {%- if one_detail != blank -%}
              <span class="ge-skin-offer__detail">{{ one_detail | escape }}</span>
            {%- endif -%}
            {%- if one_volume != blank -%}
              <span class="ge-skin-offer__volume">{{ one_volume | escape }}</span>
            {%- endif -%}
          </span>
        {%- endif -%}
      </span>
      <span class="ge-skin-offer__price">{{ unit_price | money }}</span>
    </label>
    {%- if show_bundle -%}
      <label class="ge-skin-offer{% unless two_select %} is-unavailable{% endunless %}" data-qty="2"{% unless two_select %} aria-disabled="true"{% endunless %}>
        <input type="radio" name="ge-offer-{{ section.id }}" value="2"{% unless two_select %} disabled{% endunless %}>
        <span class="ge-skin-offer__copy">
          {%- if bundle_badge != blank and two_buy -%}
            <span class="ge-skin-offer__badge">{{ bundle_badge | escape }}</span>
          {%- endif -%}
          <span class="ge-skin-offer__name">{{ bundle_title | escape }}</span>
          {%- if bundle_detail != blank or bundle_volume != blank -%}
            <span class="ge-skin-offer__meta">
              {%- if bundle_detail != blank -%}
                <span class="ge-skin-offer__detail">{{ bundle_detail | escape }}</span>
              {%- endif -%}
              {%- if bundle_volume != blank -%}
                <span class="ge-skin-offer__volume">{{ bundle_volume | escape }}</span>
              {%- endif -%}
            </span>
          {%- endif -%}
        </span>
        <span class="ge-skin-offer__price">{{ pair_price | money }}</span>
      </label>
    {%- endif -%}
  </div>
  <input
    type="hidden"
    name="quantity"
    value="1"
    min="1"
    form="{{ product_form_id }}"
    data-ge-offer-qty
  >
  <script type="application/json" data-ge-offer-stock>
    {{ offer_stock | strip }}
  </script>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-ge-offers][data-section="{{ section.id }}"]');
    if (!root || root.dataset.offerBound === 'true') return;
    root.dataset.offerBound = 'true';
    var qty = root.querySelector('[data-ge-offer-qty]');
    var stockNode = root.querySelector('[data-ge-offer-stock]');
    var stock = [];
    try { stock = JSON.parse(stockNode ? stockNode.textContent : '[]'); } catch (error) { stock = []; }

    var setCard = function (card, canSelect) {
      if (!card) return;
      var input = card.querySelector('input');
      card.classList.toggle('is-unavailable', !canSelect);
      if (canSelect) card.removeAttribute('aria-disabled');
      else card.setAttribute('aria-disabled', 'true');
      if (input) input.disabled = !canSelect;
    };

    var apply = function (value) {
      var card = root.querySelector('.ge-skin-offer[data-qty="' + value + '"]');
      if (!card || card.classList.contains('is-unavailable')) return;
      if (qty) qty.value = value;
      root.querySelectorAll('.ge-skin-offer').forEach(function (item) {
        var input = item.querySelector('input');
        var selected = input && input.value === value && !input.disabled;
        item.classList.toggle('is-selected', selected);
        if (input) input.checked = selected;
      });
      var formatted = value === '2' ? root.getAttribute('data-price-two') : root.getAttribute('data-price-one');
      var atcPrice = document.querySelector('#product-form-{{ section.id }} [data-ge-atc-price]');
      if (atcPrice && formatted) atcPrice.textContent = formatted;
      var sticky = document.getElementById('price-{{ section.id }}--sticky');
      if (!sticky || !formatted) return;
      var amount = sticky.querySelector('ins .amount') || sticky.querySelector('.amount');
      if (amount) amount.textContent = formatted;
    };

    var sync = function (record) {
      if (!record) return;
      root.setAttribute('data-price-one', record.priceOne);
      root.setAttribute('data-price-two', record.priceTwo);
      var one = root.querySelector('.ge-skin-offer[data-qty="1"]');
      var two = root.querySelector('.ge-skin-offer[data-qty="2"]');
      var soldOut = !record.one && !record.two;
      setCard(one, soldOut || record.one);
      setCard(two, soldOut || record.two);
      if (one) {
        var onePrice = one.querySelector('.ge-skin-offer__price');
        if (onePrice) onePrice.textContent = record.priceOne;
      }
      if (two) {
        var twoPrice = two.querySelector('.ge-skin-offer__price');
        if (twoPrice) twoPrice.textContent = record.priceTwo;
      }
      var checked = root.querySelector('input[type="radio"]:checked');
      if (checked && !checked.disabled) {
        apply(checked.value);
        return;
      }
      if (soldOut || record.one) apply('1');
      else if (record.two) apply('2');
      else if (qty) {
        qty.value = '1';
        var atcPrice = document.querySelector('#product-form-{{ section.id }} [data-ge-atc-price]');
        if (atcPrice && record.priceOne) atcPrice.textContent = record.priceOne;
        var sticky = document.getElementById('price-{{ section.id }}--sticky');
        if (sticky && record.priceOne) {
          var amount = sticky.querySelector('ins .amount') || sticky.querySelector('.amount');
          if (amount) amount.textContent = record.priceOne;
        }
      }
    };

    root.querySelectorAll('input[type="radio"]').forEach(function (radio) {
      radio.addEventListener('change', function () {
        if (radio.checked && !radio.disabled) apply(radio.value);
      });
    });

    document.addEventListener('product:variant-change', function (event) {
      var detail = event.detail || {};
      if (detail.sectionId && String(detail.sectionId) !== root.getAttribute('data-section')) return;
      if (!detail.variant) {
        sync({ one: false, two: false, priceOne: root.getAttribute('data-price-one'), priceTwo: root.getAttribute('data-price-two') });
        return;
      }
      var match = stock.filter(function (item) { return item.id === detail.variant.id; })[0];
      if (match) sync(match);
    });
  })();
</script>
