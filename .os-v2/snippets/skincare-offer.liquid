{% doc %}
  One purchase card with a one-time radio and a subscribe radio.
  Quantity stays at one. Subscribe submits the product's Shopify selling plan. One-time purchase does not.
  The card can be changed while the variant is sold out. The add-to-bag button stays sold out.
  @param {product} product - Product being purchased
  @param {block} block - Theme editor block with the card lines
  @param {section} section - Product section, used for the form id
  @example
  {% render 'skincare-offer', product: product, block: block, section: section %}
{% enddoc %}

{{ 'skincare-pdp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign variant = product.selected_variant
  if variant == blank
    assign variant = product.selected_or_first_available_variant
  endif
  if product.handle == 'sunday-reset-overnight-glow-mask'
    for candidate in product.variants
      assign candidate_title = candidate.title | downcase | strip
      if candidate_title == '50 ml'
        assign variant = candidate
        break
      endif
    endfor
  endif
  assign unit_price = variant.price
  assign product_form_id = 'product-form-' | append: section.id
  assign is_kit = false
  if product.handle == 'sunday-reset-ritual-kit'
    assign is_kit = true
  endif
  if is_kit
    assign detail = block.settings.kit_one_detail | default: '4 single-use sachets'
    assign volume = block.settings.kit_one_volume | default: '8 mL | 0.28 fl oz'
  else
    assign detail = block.settings.mask_one_detail | default: ''
    assign volume = block.settings.mask_one_volume | default: '50 mL | 1.69 fl oz'
  endif
  assign once_label = block.settings.once_label | default: 'One-time purchase'
  assign once_text = block.settings.once_text | default: 'A little reset, whenever you need it.'
  assign subscribe_text = block.settings.subscribe_text | default: 'Your ritual, on repeat.'
  assign subscribe_check = block.settings.subscribe_check | default: 'Automatic deliveries. Skip, pause, or cancel.'

  assign plan_allocation = nil
  if variant.selling_plan_allocations.size > 0
    assign plan_allocation = variant.selling_plan_allocations.first
  endif
  if product.selected_selling_plan
    for allocation in variant.selling_plan_allocations
      if allocation.selling_plan.id == product.selected_selling_plan.id
        assign plan_allocation = allocation
        break
      endif
    endfor
  endif

  assign show_plan = false
  if plan_allocation != blank and block.settings.show_subscribe != false
    assign show_plan = true
  endif
  assign plan_mode = 'once'
  if show_plan
    assign plan_mode = 'subscribe'
  endif
  assign sub_price = unit_price
  assign plan_id = ''
  assign cadence = ''
  assign save_value = ''
  if plan_allocation != blank
    assign sub_price = plan_allocation.price
    assign plan_id = plan_allocation.selling_plan.id
    assign cadence = plan_allocation.selling_plan.options | first
    if cadence == blank
      assign cadence = plan_allocation.selling_plan.name
    endif
    for adjustment in plan_allocation.selling_plan.price_adjustments
      if adjustment.value_type == 'percentage'
        assign save_value = adjustment.value | round
      endif
    endfor
  endif
  assign subscribe_label = 'Subscribe & save'
  if save_value != blank
    assign subscribe_label = subscribe_label | append: ' ' | append: save_value | append: '%'
  endif
-%}

{%- capture offer_stock -%}
[
{%- for offer_variant in product.variants -%}
  {%- liquid
    assign loop_plan_id = 0
    assign loop_sub = offer_variant.price
    if offer_variant.selling_plan_allocations.size > 0
      assign loop_allocation = offer_variant.selling_plan_allocations.first
      assign loop_sub = loop_allocation.price
      assign loop_plan_id = loop_allocation.selling_plan.id
    endif
  -%}
  {"id":{{ offer_variant.id }},"price":{{ offer_variant.price | money | json }},"sub":{{ loop_sub | money | json }},"planId":{% if loop_plan_id == 0 %}null{% else %}{{ loop_plan_id }}{% endif %}}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
{%- endcapture -%}

<div
  class="ge-skin-offers"
  data-ge-offers
  data-section="{{ section.id }}"
  data-plan-mode="{{ plan_mode }}"
  data-price="{{ unit_price | money | escape }}"
  data-sub-price="{{ sub_price | money | escape }}"
  data-plan-id="{{ plan_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ge-skin-purchase" role="radiogroup" aria-label="Purchase options">
    <label class="ge-skin-choice{% if plan_mode == 'once' %} is-selected{% endif %}">
      <input type="radio" name="ge-plan-{{ section.id }}" value="once"{% if plan_mode == 'once' %} checked{% endif %}>
      <span class="ge-skin-choice__radio" aria-hidden="true"></span>
      <span class="ge-skin-choice__main">
        <span class="ge-skin-choice__head">
          <span class="ge-skin-choice__label">{{ once_label | escape }}</span>
          <span class="ge-skin-choice__prices">
            <span class="ge-skin-choice__price" data-ge-once-price>{{ unit_price | money }}</span>
          </span>
        </span>
        {%- if once_text != blank -%}
          <span class="ge-skin-choice__line">{{ once_text | escape }}</span>
        {%- endif -%}
        {%- if detail != blank or volume != blank -%}
          <span class="ge-skin-choice__meta">
            {%- if detail != blank -%}<span class="ge-skin-choice__detail">{{ detail | escape }}</span>{%- endif -%}
            {%- if volume != blank -%}<span class="ge-skin-choice__volume">{{ volume | escape }}</span>{%- endif -%}
          </span>
        {%- endif -%}
      </span>
    </label>
    {%- if show_plan -%}
      <label class="ge-skin-choice{% if plan_mode == 'subscribe' %} is-selected{% endif %}">
        <input type="radio" name="ge-plan-{{ section.id }}" value="subscribe"{% if plan_mode == 'subscribe' %} checked{% endif %}>
        <span class="ge-skin-choice__radio" aria-hidden="true"></span>
        <span class="ge-skin-choice__main">
          <span class="ge-skin-choice__head">
            <span class="ge-skin-choice__label">{{ subscribe_label | escape }}</span>
            <span class="ge-skin-choice__prices">
              <span class="ge-skin-choice__price" data-ge-sub-price>{{ sub_price | money }}</span>
              <s class="ge-skin-choice__compare" data-ge-compare-price>{{ unit_price | money }}</s>
            </span>
          </span>
          {%- if subscribe_text != blank -%}
            <span class="ge-skin-choice__line">{{ subscribe_text | escape }}</span>
          {%- endif -%}
          {%- if detail != blank or volume != blank -%}
            <span class="ge-skin-choice__meta">
              {%- if detail != blank -%}<span class="ge-skin-choice__detail">{{ detail | escape }}</span>{%- endif -%}
              {%- if volume != blank -%}<span class="ge-skin-choice__volume">{{ volume | escape }}</span>{%- endif -%}
            </span>
          {%- endif -%}
          {%- if cadence != blank -%}
            <span class="ge-skin-choice__cadence">{{ cadence | escape }}</span>
          {%- endif -%}
          {%- if subscribe_check != blank -%}
            <span class="ge-skin-choice__check">
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                <path d="M3.2 8.2 6.4 11.4 12.8 4.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <span>{{ subscribe_check | escape }}</span>
            </span>
          {%- endif -%}
        </span>
      </label>
    {%- endif -%}
  </div>
  <input type="hidden" name="quantity" value="1" min="1" form="{{ product_form_id }}" data-ge-offer-qty>
  {%- if show_plan -%}
    <input
      type="hidden"
      name="selling_plan"
      value="{% if plan_mode == 'subscribe' %}{{ plan_id }}{% endif %}"
      form="{{ product_form_id }}"
      data-ge-selling-plan
      {% if plan_mode != 'subscribe' %}disabled{% endif %}
    >
  {%- endif -%}
  <script type="application/json" data-ge-offer-stock>
    {{ offer_stock | strip }}
  </script>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-ge-offers][data-section="{{ section.id }}"]');
    if (!root || root.dataset.offerBound === 'true') return;
    root.dataset.offerBound = 'true';
    var qty = root.querySelector('[data-ge-offer-qty]');
    var planInput = root.querySelector('[data-ge-selling-plan]');
    var stockNode = root.querySelector('[data-ge-offer-stock]');
    var stock = [];
    try { stock = JSON.parse(stockNode ? stockNode.textContent : '[]'); } catch (error) { stock = []; }
    if (qty) qty.value = '1';

    var mode = function () {
      var selected = root.querySelector('.ge-skin-choice input[type="radio"]:checked');
      return selected ? selected.value : 'once';
    };

    var priceFor = function (value) {
      if (value === 'subscribe') return root.getAttribute('data-sub-price');
      return root.getAttribute('data-price');
    };

    var writeBag = function (formatted) {
      var atcPrice = document.querySelector('#product-form-{{ section.id }} [data-ge-atc-price]');
      if (atcPrice && formatted) atcPrice.textContent = formatted;
      var sticky = document.getElementById('price-{{ section.id }}--sticky');
      if (!sticky || !formatted) return;
      var amount = sticky.querySelector('ins .amount') || sticky.querySelector('.amount');
      if (amount) amount.textContent = formatted;
    };

    var paint = function () {
      var oncePrice = root.querySelector('[data-ge-once-price]');
      var subPrice = root.querySelector('[data-ge-sub-price]');
      var compare = root.querySelector('[data-ge-compare-price]');
      if (oncePrice) oncePrice.textContent = root.getAttribute('data-price') || '';
      if (subPrice) subPrice.textContent = root.getAttribute('data-sub-price') || '';
      if (compare) compare.textContent = root.getAttribute('data-price') || '';
    };

    var apply = function (value) {
      root.querySelectorAll('.ge-skin-choice').forEach(function (choice) {
        var input = choice.querySelector('input[type="radio"]');
        var selected = input && input.value === value;
        if (input) input.checked = selected;
        choice.classList.toggle('is-selected', selected);
      });
      if (planInput) {
        var planId = value === 'subscribe' ? (root.getAttribute('data-plan-id') || '') : '';
        planInput.value = planId;
        planInput.disabled = planId === '';
      }
      root.setAttribute('data-plan-mode', value);
      paint();
      writeBag(priceFor(value));
    };

    root.querySelectorAll('.ge-skin-choice input[type="radio"]').forEach(function (radio) {
      radio.addEventListener('change', function () {
        if (radio.checked) apply(radio.value);
      });
    });

    document.addEventListener('product:variant-change', function (event) {
      var detail = event.detail || {};
      if (detail.sectionId && String(detail.sectionId) !== root.getAttribute('data-section')) return;
      if (!detail.variant) return;
      var match = stock.filter(function (item) { return item.id === detail.variant.id; })[0];
      if (!match) return;
      root.setAttribute('data-price', match.price || '');
      if (match.sub) root.setAttribute('data-sub-price', match.sub);
      if (match.planId) root.setAttribute('data-plan-id', String(match.planId));
      var subscribeChoice = root.querySelector('.ge-skin-choice input[value="subscribe"]');
      if (subscribeChoice) subscribeChoice.closest('.ge-skin-choice').hidden = !match.planId;
      apply(match.planId ? mode() : 'once');
    });

    var start = function () { apply(root.getAttribute('data-plan-mode') || 'once'); };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
    else start();
  })();
</script>
