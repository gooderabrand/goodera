{% doc %}
  One purchase card with a one-time radio and a subscribe radio.
  Quantity stays at one. Subscribe submits the product's Shopify selling plan. One-time purchase does not.
  The card can be changed while the variant is sold out. The add-to-bag button stays sold out.
  @param {product} product - Product being purchased
  @param {block} block - Theme editor block with the card lines
  @param {section} section - Product section, used for the form id
  @example
  {% render 'skincare-offer', product: product, block: block, section: section %}
{% enddoc %}

{{ 'skincare-pdp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign variant = product.selected_variant
  if variant == blank
    assign variant = product.selected_or_first_available_variant
  endif
  if product.handle == 'sunday-reset-overnight-glow-mask'
    for candidate in product.variants
      assign candidate_title = candidate.title | downcase | strip
      if candidate_title == '50 ml'
        assign variant = candidate
        break
      endif
    endfor
  endif
  assign unit_price = variant.price
  assign product_form_id = 'product-form-' | append: section.id
  assign once_label = block.settings.once_label | default: 'One-time purchase'
  assign once_text = block.settings.once_text | default: 'A little reset, whenever you need it.'
  assign subscribe_text = block.settings.subscribe_text | default: 'Your ritual, on repeat.'
  assign subscribe_check = block.settings.subscribe_check | default: 'Automatic deliveries. Skip, pause, or cancel.'

  assign plan_allocation = nil
  if variant.selling_plan_allocations.size > 0
    assign plan_allocation = variant.selling_plan_allocations.first
  endif
  if product.selected_selling_plan
    for allocation in variant.selling_plan_allocations
      if allocation.selling_plan.id == product.selected_selling_plan.id
        assign plan_allocation = allocation
        break
      endif
    endfor
  endif

  assign show_plan = false
  if plan_allocation != blank and block.settings.show_subscribe != false
    assign show_plan = true
  endif
  assign plan_mode = 'once'
  if show_plan
    assign plan_mode = 'subscribe'
  endif
  assign sub_price = unit_price
  assign plan_id = ''
  assign cadence = ''
  assign save_value = ''
  assign plan_count = variant.selling_plan_allocations.size
  if plan_allocation != blank
    assign sub_price = plan_allocation.price
    assign plan_id = plan_allocation.selling_plan.id
    assign plan_option = plan_allocation.selling_plan.options | first
    if plan_option != blank
      assign cadence = plan_option.value
    endif
    if cadence == blank
      assign cadence = plan_allocation.selling_plan.name
    endif
    for adjustment in plan_allocation.selling_plan.price_adjustments
      if adjustment.value_type == 'percentage'
        assign save_value = adjustment.value | round
      endif
    endfor
  endif
  assign subscribe_label = 'Subscribe & save'
  if save_value != blank
    assign subscribe_label = subscribe_label | append: ' ' | append: save_value | append: '%'
  endif
-%}

{%- capture offer_stock -%}
[
{%- for offer_variant in product.variants -%}
  {%- liquid
    assign loop_plan_id = 0
    assign loop_sub = offer_variant.price
    if offer_variant.selling_plan_allocations.size > 0
      assign loop_allocation = offer_variant.selling_plan_allocations.first
      assign loop_sub = loop_allocation.price
      assign loop_plan_id = loop_allocation.selling_plan.id
    endif
  -%}
  {"id":{{ offer_variant.id }},"price":{{ offer_variant.price | money | json }},"priceCents":{{ offer_variant.price }},"sub":{{ loop_sub | money | json }},"subCents":{{ loop_sub }},"planId":{% if loop_plan_id == 0 %}null{% else %}{{ loop_plan_id }}{% endif %},"plans":[{%- for allocation in offer_variant.selling_plan_allocations -%}{%- liquid
      assign freq_label = ''
      assign freq_option = allocation.selling_plan.options | first
      if freq_option != blank
        assign freq_label = freq_option.value
      endif
      if freq_label == blank
        assign freq_label = allocation.selling_plan.name
      endif
    -%}{"id":{{ allocation.selling_plan.id }},"price":{{ allocation.price | money | json }},"cents":{{ allocation.price }},"label":{{ freq_label | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
{%- endcapture -%}

<div
  class="ge-skin-offers"
  data-ge-offers
  data-section="{{ section.id }}"
  data-plan-mode="{{ plan_mode }}"
  data-price="{{ unit_price | money | escape }}"
  data-sub-price="{{ sub_price | money | escape }}"
  data-price-cents="{{ unit_price }}"
  data-sub-cents="{{ sub_price }}"
  data-plan-id="{{ plan_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ge-skin-purchase" role="radiogroup" aria-label="Purchase options">
    <label class="ge-skin-choice{% if plan_mode == 'once' %} is-selected{% endif %}">
      <input type="radio" name="ge-plan-{{ section.id }}" value="once"{% if plan_mode == 'once' %} checked{% endif %}>
      <span class="ge-skin-choice__radio" aria-hidden="true"></span>
      <span class="ge-skin-choice__main">
        <span class="ge-skin-choice__head">
          <span class="ge-skin-choice__label">{{ once_label | escape }}</span>
          <span class="ge-skin-choice__prices">
            <span class="ge-skin-choice__price" data-ge-once-price>{{ unit_price | money }}</span>
          </span>
        </span>
        {%- if once_text != blank -%}
          <span class="ge-skin-choice__line">{{ once_text | escape }}</span>
        {%- endif -%}
      </span>
    </label>
    {%- if show_plan -%}
      <div class="ge-skin-choice{% if plan_mode == 'subscribe' %} is-selected{% endif %}">
        <input type="radio" name="ge-plan-{{ section.id }}" value="subscribe" aria-label="{{ subscribe_label | escape }}"{% if plan_mode == 'subscribe' %} checked{% endif %}>
        <span class="ge-skin-choice__radio" aria-hidden="true"></span>
        <span class="ge-skin-choice__main">
          <span class="ge-skin-choice__head">
            <span class="ge-skin-choice__label">{{ subscribe_label | escape }}</span>
            <span class="ge-skin-choice__prices">
              <span class="ge-skin-choice__price" data-ge-sub-price>{{ sub_price | money }}</span>
              <s class="ge-skin-choice__compare" data-ge-compare-price>{{ unit_price | money }}</s>
            </span>
          </span>
          {%- if subscribe_text != blank -%}
            <span class="ge-skin-choice__line">{{ subscribe_text | escape }}</span>
          {%- endif -%}
          {%- if plan_count > 1 -%}
            <span class="ge-skin-choice__freqs" role="radiogroup" aria-label="Delivery frequency">
              {%- for allocation in variant.selling_plan_allocations -%}
                {%- liquid
                  assign freq_label = ''
                  assign freq_option = allocation.selling_plan.options | first
                  if freq_option != blank
                    assign freq_label = freq_option.value
                  endif
                  if freq_label == blank
                    assign freq_label = allocation.selling_plan.name
                  endif
                  assign freq_selected = false
                  if allocation.selling_plan.id == plan_id
                    assign freq_selected = true
                  endif
                -%}
                <label class="ge-skin-freq{% if freq_selected %} is-selected{% endif %}">
                  <input
                    type="radio"
                    name="ge-freq-{{ section.id }}"
                    value="{{ allocation.selling_plan.id }}"
                    data-plan-id="{{ allocation.selling_plan.id }}"
                    data-sub-price="{{ allocation.price | money | escape }}"
                    data-sub-cents="{{ allocation.price }}"
                    {% if freq_selected %}checked{% endif %}
                  >
                  <span>{{ freq_label | escape }}</span>
                </label>
              {%- endfor -%}
            </span>
          {%- elsif cadence != blank -%}
            <span class="ge-skin-choice__cadence">{{ cadence | escape }}</span>
          {%- endif -%}
          {%- if subscribe_check != blank -%}
            <span class="ge-skin-choice__check">
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                <path d="M3.2 8.2 6.4 11.4 12.8 4.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <span>{{ subscribe_check | escape }}</span>
            </span>
          {%- endif -%}
        </span>
      </div>
    {%- endif -%}
  </div>
  <input type="hidden" name="quantity" value="1" min="1" form="{{ product_form_id }}" data-ge-offer-qty>
  {%- if show_plan -%}
    <input
      type="hidden"
      name="selling_plan"
      value="{% if plan_mode == 'subscribe' %}{{ plan_id }}{% endif %}"
      form="{{ product_form_id }}"
      data-ge-selling-plan
      {% if plan_mode != 'subscribe' %}disabled{% endif %}
    >
  {%- endif -%}
  <script type="application/json" data-ge-offer-stock>
    {{ offer_stock | strip }}
  </script>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-ge-offers][data-section="{{ section.id }}"]');
    if (!root || root.dataset.offerBound === 'true') return;
    root.dataset.offerBound = 'true';
    var qty = root.querySelector('[data-ge-offer-qty]');
    var planInput = root.querySelector('[data-ge-selling-plan]');
    var stockNode = root.querySelector('[data-ge-offer-stock]');
    var stock = [];
    try { stock = JSON.parse(stockNode ? stockNode.textContent : '[]'); } catch (error) { stock = []; }
    if (qty) qty.value = '1';

    var purchaseRadios = function () {
      return root.querySelectorAll('input[name^="ge-plan-"]');
    };

    var mode = function () {
      var selected = root.querySelector('input[name^="ge-plan-"]:checked');
      return selected ? selected.value : 'once';
    };

    var markFreqs = function () {
      root.querySelectorAll('.ge-skin-freq').forEach(function (item) {
        var input = item.querySelector('input');
        item.classList.toggle('is-selected', !!(input && input.checked));
      });
    };

    var priceFor = function (value) {
      if (value === 'subscribe') return root.getAttribute('data-sub-price');
      return root.getAttribute('data-price');
    };

    var writeBag = function (formatted) {
      var atcPrice = document.querySelector('#product-form-{{ section.id }} [data-ge-atc-price]');
      if (atcPrice && formatted) atcPrice.textContent = formatted;
      var sticky = document.getElementById('price-{{ section.id }}--sticky');
      if (!sticky || !formatted) return;
      var amount = sticky.querySelector('ins .amount') || sticky.querySelector('.amount');
      if (amount) amount.textContent = formatted;
    };

    var paint = function () {
      var oncePrice = root.querySelector('[data-ge-once-price]');
      var subPrice = root.querySelector('[data-ge-sub-price]');
      var compare = root.querySelector('[data-ge-compare-price]');
      if (oncePrice) oncePrice.textContent = root.getAttribute('data-price') || '';
      if (subPrice) subPrice.textContent = root.getAttribute('data-sub-price') || '';
      if (compare) compare.textContent = root.getAttribute('data-price') || '';
    };

    var apply = function (value) {
      purchaseRadios().forEach(function (input) {
        var selected = input.value === value;
        input.checked = selected;
        var choice = input.closest('.ge-skin-choice');
        if (choice) choice.classList.toggle('is-selected', selected);
      });
      markFreqs();
      if (planInput) {
        var planId = value === 'subscribe' ? (root.getAttribute('data-plan-id') || '') : '';
        planInput.value = planId;
        planInput.disabled = planId === '';
      }
      root.setAttribute('data-plan-mode', value);
      paint();
      writeBag(priceFor(value));
      syncInstallments();
    };

    var syncInstallments = function () {
      var mode = root.getAttribute('data-plan-mode');
      var cents = mode === 'subscribe' ? root.getAttribute('data-sub-cents') : root.getAttribute('data-price-cents');
      var dollars = Math.round(Number(cents)) / 100;
      if (!isFinite(dollars)) return;
      document.querySelectorAll('shopify-payment-terms').forEach(function (el) {
        var liveMeta = el.shopifyMeta;
        var source = el.getAttribute('data-ge-installment-source') || el.getAttribute('shopify-meta') || (typeof liveMeta === 'string' ? liveMeta : '');
        if (!source && liveMeta && typeof liveMeta === 'object') source = JSON.stringify(liveMeta);
        if (!source) {
          var metaScript = el.querySelector('script[type="application/json"]');
          if (metaScript) source = metaScript.textContent || '';
        }
        if (!source) return;
        if (!el.getAttribute('data-ge-installment-source')) el.setAttribute('data-ge-installment-source', source);
        var meta;
        try { meta = JSON.parse(el.getAttribute('data-ge-installment-source')); } catch (error) { return; }
        var variants = meta.variants || [];
        var variantId = Number(el.getAttribute('variant-id') || el.variantId || 0);
        var touched = false;
        variants.forEach(function (variant) {
          if (variantId && Number(variant.id) !== variantId) return;
          var sample = String(variant.full_price || '');
          var parsed = parseFloat(sample.replace(/[^0-9.]/g, ''));
          var current = Number(variant.full_price_amount);
          var nextAmount = dollars;
          if (isFinite(current) && isFinite(parsed) && parsed > 0 && current > parsed * 20) nextAmount = Math.round(dollars * 100);
          variant.full_price_amount = nextAmount;
          if (sample) variant.full_price = sample.replace(/[0-9][0-9.,]*/, dollars.toFixed(2));
          touched = true;
        });
        if (!touched) return;
        var next = JSON.stringify(meta);
        if (el.getAttribute('shopify-meta') !== next) el.setAttribute('shopify-meta', next);
        try { if (el.shopifyMeta !== next) el.shopifyMeta = next; } catch (error) {}
      });
    };

    purchaseRadios().forEach(function (radio) {
      radio.addEventListener('change', function () {
        if (radio.checked) apply(radio.value);
      });
    });

    root.querySelectorAll('.ge-skin-choice').forEach(function (choice) {
      choice.addEventListener('click', function (event) {
        if (event.target.closest('.ge-skin-choice__freqs')) return;
        var input = choice.querySelector('input[name^="ge-plan-"]');
        if (!input || input.checked) return;
        input.checked = true;
        apply(input.value);
      });
    });

    root.querySelectorAll('.ge-skin-freq input').forEach(function (radio) {
      radio.addEventListener('change', function () {
        if (!radio.checked) return;
        root.setAttribute('data-plan-id', radio.getAttribute('data-plan-id') || '');
        root.setAttribute('data-sub-price', radio.getAttribute('data-sub-price') || '');
        if (radio.getAttribute('data-sub-cents')) root.setAttribute('data-sub-cents', radio.getAttribute('data-sub-cents'));
        var purchase = root.querySelector('input[name^="ge-plan-"][value="subscribe"]');
        if (purchase) purchase.checked = true;
        apply('subscribe');
      });
    });

    document.addEventListener('product:variant-change', function (event) {
      var detail = event.detail || {};
      if (detail.sectionId && String(detail.sectionId) !== root.getAttribute('data-section')) return;
      if (!detail.variant) return;
      var match = stock.filter(function (item) { return item.id === detail.variant.id; })[0];
      if (!match) return;
      root.setAttribute('data-price', match.price || '');
      if (match.priceCents) root.setAttribute('data-price-cents', String(match.priceCents));
      var plans = match.plans || [];
      var currentId = root.getAttribute('data-plan-id') || '';
      var picked = null;
      plans.forEach(function (plan) {
        var id = String(plan.id);
        var input = root.querySelector('.ge-skin-freq input[data-plan-id="' + id + '"]');
        if (input && plan.price) input.setAttribute('data-sub-price', plan.price);
        if (input && plan.cents) input.setAttribute('data-sub-cents', String(plan.cents));
        if (id === String(currentId)) picked = plan;
      });
      if (!picked && plans.length) picked = plans[0];
      if (picked) {
        root.setAttribute('data-sub-price', picked.price || '');
        if (picked.cents) root.setAttribute('data-sub-cents', String(picked.cents));
        root.setAttribute('data-plan-id', String(picked.id));
        var freq = root.querySelector('.ge-skin-freq input[data-plan-id="' + String(picked.id) + '"]');
        if (freq) freq.checked = true;
      } else if (match.sub) {
        root.setAttribute('data-sub-price', match.sub);
        if (match.subCents) root.setAttribute('data-sub-cents', String(match.subCents));
        if (match.planId) root.setAttribute('data-plan-id', String(match.planId));
      }
      var subscribeChoice = root.querySelector('input[name^="ge-plan-"][value="subscribe"]');
      if (subscribeChoice) subscribeChoice.closest('.ge-skin-choice').hidden = !match.planId;
      apply(match.planId ? mode() : 'once');
    });

    var start = function () {
      apply(root.getAttribute('data-plan-mode') || 'once');
      var tries = 0;
      var timer = setInterval(function () {
        tries += 1;
        syncInstallments();
        if (tries >= 20) clearInterval(timer);
      }, 300);
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
    else start();
  })();
</script>
