{% doc %}
  Renders the skincare Description accordion body.
  Uses the product description when it exists, and appends product.metafields.custom.study_note when that note is set.
  @param {product} product - Product whose description is shown
  @example
  {% render 'skincare-description', product: product %}
{% enddoc %}

{{ 'skincare-pdp.css' | asset_url | stylesheet_tag }}

{%- if product.description != blank -%}
  {{ product.description }}
{%- elsif product.handle == 'sunday-reset-overnight-glow-mask' -%}
  <p>{{ 'products.skincare.mask_how_to' | t }}</p>
{%- elsif product.handle == 'sunday-reset-ritual-kit' -%}
  <p>{{ 'products.skincare.kit_highlight_1' | t }} {{ 'products.skincare.kit_highlight_2' | t }}</p>
{%- else -%}
  <p>{{ 'products.skincare.description_sample' | t }}</p>
{%- endif -%}

{%- liquid
  assign study_note = ''
  if product.metafields.custom.study_note != blank
    assign study_note = product.metafields.custom.study_note | metafield_text | strip
  elsif product.description == blank and product.handle != 'sunday-reset-overnight-glow-mask' and product.handle != 'sunday-reset-ritual-kit'
    assign study_note = 'products.skincare.study_note_sample' | t
  endif
-%}
{%- if study_note != blank -%}
  <p class="ge-skin-note">{{ study_note | escape }}</p>
{%- endif -%}
