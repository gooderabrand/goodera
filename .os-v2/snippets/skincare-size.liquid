{% doc %}
  Size row for the skincare buy box.
  A product with a Size, Volume, or Amount option uses the variant choices. Sold-out choices cannot be selected.
  A product that still has one fill shows custom.size_label in the same underline row. Empty size labels stay hidden.
  @param {product} product - Product being purchased
  @example
  {% render 'skincare-size', product: product %}
{% enddoc %}

{%- liquid
  assign size_option = false
  for option in product.options_with_values
    assign option_name = option.name | downcase | strip
    if option_name == 'size' or option_name == 'volume' or option_name == 'amount'
      assign size_option = true
    endif
  endfor
  assign size_label = product.metafields.custom.size_label.value | strip
  assign size_available = product.selected_or_first_available_variant.available
-%}

{%- if size_option -%}
  <script>
    (function () {
      var lock = function () {
        document.querySelectorAll('variant-selects input[type="radio"]').forEach(function (input) {
          input.disabled = input.classList.contains('is-disabled');
        });
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', lock);
      } else {
        lock();
      }
      window.addEventListener('load', lock);
      document.addEventListener('product:variant-change', lock);
    })();
  </script>
{%- elsif size_label != blank -%}
  <div class="ge-skin-size">
    <p class="ge-skin-size__heading">{{ 'products.skincare.size' | t }}</p>
    <div class="ge-skin-size__options" role="radiogroup" aria-label="{{ 'products.skincare.size' | t }}">
      <span class="ge-skin-size__choice is-selected{% unless size_available %} is-unavailable{% endunless %}">
        {%- render 'skincare-size-name', value: size_label, with_ounces: true -%}
      </span>
    </div>
  </div>
{%- endif -%}
