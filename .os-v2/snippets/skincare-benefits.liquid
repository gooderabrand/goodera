{% doc %}
  Stars and benefit chips under the product title.
  Stars render only when a review app has a rating above zero.
  Chips read product.metafields.custom.benefit_highlights.
  An empty list hides the chips.
  @param {product} product - Product whose rating and benefits are shown
  @example
  {% render 'skincare-benefits', product: product %}
{% enddoc %}

{%- liquid
  assign rating_number = 0
  assign rating_count = 0
  assign rating_value = product.metafields.reviews.rating.value.rating
  if rating_value != blank
    assign rating_number = rating_value | plus: 0
  endif
  if product.metafields.reviews.rating_count.value != blank
    assign rating_count = product.metafields.reviews.rating_count.value
  elsif product.metafields.reviews.rating_count != blank
    assign rating_count = product.metafields.reviews.rating_count
  endif
  if rating_number == 0
    assign badge = product.metafields.judgeme.badge.value
    if badge != blank
      assign badge_rating = badge | split: "data-average-rating='" | last | split: "'" | first | plus: 0
      assign badge_count = badge | split: "data-number-of-reviews='" | last | split: "'" | first | plus: 0
      if badge_rating > 0
        assign rating_number = badge_rating
        assign rating_count = badge_count
      endif
    endif
  endif
  assign benefits = product.metafields.custom.benefit_highlights
-%}

{%- capture benefit_items -%}
  {%- if benefits != blank and benefits.value != blank -%}
    {%- for item in benefits.value -%}
      {%- assign item_text = item | strip -%}
      {%- if item_text != blank -%}
        <li>{{ item_text | escape }}</li>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- assign benefit_items = benefit_items | strip -%}

{%- if rating_number > 0 or benefit_items != blank -%}
  {{ 'skincare-pdp.css' | asset_url | stylesheet_tag }}
  <div class="ge-skin-buy-meta">
    {%- if rating_number > 0 -%}
      <p class="ge-skin-stars">
        <span class="star-rating" style="--star-rating: {{ rating_number }};" aria-hidden="true"></span>
        <span>{{ 'products.product.reviews' | t: count: rating_count }}</span>
      </p>
    {%- endif -%}
    {%- if benefit_items != blank -%}
      <ul class="ge-skin-benefits">
        {{ benefit_items }}
      </ul>
    {%- endif -%}
  </div>
{%- endif -%}
