/*
 * ------------------------------------------------------------
 * Skincare PDP — clothing gallery and buy box, with highlights,
 * specifications, results, routine, how-to video, and FAQ.
 * Assigned via product template suffix "skincare".
 * ------------------------------------------------------------
 */
{
  "sections": {
    "breadcrumbs": {
      "type": "breadcrumbs",
      "settings": {}
    },
    "main-product": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {
            "uppercase": false,
            "show_products_rating": false,
            "show_custom_badges": true
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "color_picker": false,
            "color_picker_size": "regular",
            "color_picker_use_variants": false,
            "variant_is_disabled": true,
            "sizing_guide_variant": "Size",
            "sizing_guide_text": "",
            "sizing_guide_icon": "none",
            "sizing_guide_page": ""
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity_selector": false,
            "outline_button": false,
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "highlights": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Highlights",
            "open": true,
            "content": "",
            "page": "",
            "custom_liquid": "{% render 'skincare-highlights', product: product %}"
          }
        },
        "description": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Description",
            "open": true,
            "content": "",
            "page": "",
            "custom_liquid": "{% render 'skincare-description', product: product %}"
          }
        },
        "specifications": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Specifications",
            "open": true,
            "content": "",
            "page": "",
            "custom_liquid": "{% render 'skincare-specs', product: product %}"
          }
        }
      },
      "block_order": [
        "title",
        "variant_picker",
        "buy_buttons",
        "highlights",
        "description",
        "specifications"
      ],
      "settings": {
        "full_width": true,
        "enable_sticky_info": true,
        "enable_sticky_add_to_cart": true,
        "show_taxes_included": false,
        "media_layout": "grid",
        "display_slider_pagination": true,
        "media_aspect_ratio": "portrait",
        "display_captions": false,
        "hide_variants": false,
        "lightbox": false,
        "enable_video_looping": false
      }
    },
    "skincare_results": {
      "type": "skincare-results",
      "blocks": {
        "result_1": {
          "type": "result",
          "settings": {
            "percent": 100,
            "text": "of participants agreed it felt lightweight and comfortable on the skin*"
          }
        },
        "result_2": {
          "type": "result",
          "settings": {
            "percent": 96,
            "text": "of participants agreed it did not pill*"
          }
        },
        "result_3": {
          "type": "result",
          "settings": {
            "percent": 96,
            "text": "of participants agreed it did not cause breakouts*"
          }
        },
        "result_4": {
          "type": "result",
          "settings": {
            "percent": 93,
            "text": "of participants agreed it layered well under makeup*"
          }
        }
      },
      "block_order": ["result_1", "result_2", "result_3", "result_4"],
      "settings": {
        "image_alt": "",
        "footnote": "*Within an independent consumer perception study of 30 people (ages 18-55), measuring performance immediately."
      }
    },
    "skincare_routine": {
      "type": "skincare-routine",
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "label": "Step 1: Cleanse",
            "name": "Pink Dew Gel Cleanser",
            "current": false
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "label": "Step 2: Treat",
            "name": "CC Me Serum",
            "current": false
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "label": "Step 3: Moisturize",
            "name": "Cloud Dew Gel Cream Moisturizer",
            "current": false
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "label": "Step 4: Protect",
            "name": "ShadeDrops Mineral Milk Sunscreen",
            "current": true
          }
        }
      },
      "block_order": ["step_1", "step_2", "step_3", "step_4"],
      "settings": {
        "heading": "",
        "explore_prefix": "Explore"
      }
    },
    "skincare_how_to": {
      "type": "skincare-how-to",
      "settings": {
        "title": "",
        "instructions": "Shake well before use. Apply evenly over skin as the final step in your skincare routine. Reapply every two hours when in the sun."
      }
    },
    "skincare_faq": {
      "type": "skincare-faq",
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "What does it feel like on skin?",
            "answer": "Lightweight and comfortable. It is meant to sit as the last step without a heavy finish."
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "Will it pill under makeup?",
            "answer": "In an independent consumer study, 96% of participants agreed it did not pill."
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "Can I use it on sensitive skin?",
            "answer": "It is suitable for dry and sensitive skin. Stop using it if irritation occurs."
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "Where does it go in my routine?",
            "answer": "Cleanse, treat, then moisturize. Apply this as the protect step."
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "question": "How do I apply it?",
            "answer": "Apply evenly over skin as the final step. Reapply every two hours when you are in the sun."
          }
        }
      },
      "block_order": ["faq_1", "faq_2", "faq_3", "faq_4", "faq_5"],
      "settings": {
        "eyebrow": "Good to know",
        "heading_line_1": "Your questions,",
        "heading_line_2": "answered.",
        "lede": "Texture, skin type, and how it fits the rest of your routine."
      }
    },
    "recently_viewed_products_pdPAhT": {
      "type": "recently-viewed-products",
      "settings": {
        "heading": "Recently Viewed",
        "heading_left": true,
        "description": "",
        "full_width": true,
        "mobile_swipe": true,
        "disable_top_spacing": false,
        "disable_bottom_spacing": false
      }
    }
  },
  "order": [
    "breadcrumbs",
    "main-product",
    "skincare_results",
    "skincare_routine",
    "skincare_how_to",
    "skincare_faq",
    "recently_viewed_products_pdPAhT"
  ]
}
