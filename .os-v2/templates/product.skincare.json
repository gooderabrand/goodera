    "skincare_faq": {
      "type": "skincare-faq",
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "What is Sunday Reset Overnight Glow Mask?",
            "answer": "An overnight cream moisturizer worn as a leave-on face mask. It helps replenish moisture and soften skin as the final step of your evening skincare routine.",
            "show_for": "both"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "Is it a sheet mask?",
            "answer": "No. It's a cream you apply directly to your skin and leave on overnight. No sheet to unfold.",
            "show_for": "both"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "When does it go in my routine?",
            "answer": "Use it as your final skincare step in the evening, on clean, dry skin. Follow the directions for any earlier products in your routine.",
            "show_for": "both"
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "Do I rinse it off after applying?",
            "answer": "No. Allow it to absorb and leave it on overnight.",
            "show_for": "both"
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "question": "Do I have to use it on Sunday?",
            "answer": "Sunday is the inspiration, not a rule. Make it part of the evening that works for you, following the product directions. Beta testers should follow their welcome-guide schedule.",
            "show_for": "both"
          }
        },
        "faq_6": {
          "type": "faq",
          "settings": {
            "question": "What's inside the Ritual Kit?",
            "answer": "Four individually packed uses of Sunday Reset Overnight Glow Mask. Every sachet contains the same cream.",
            "show_for": "kit"
          }
        },
        "faq_7": {
          "type": "faq",
          "settings": {
            "question": "How long does the Ritual Kit last?",
            "answer": "There are four single-use sachets. Use one each Sunday for four weekly rituals, or follow the schedule supplied with your kit.",
            "show_for": "kit"
          }
        },
        "faq_8": {
          "type": "faq",
          "settings": {
            "question": "Are these four different skincare steps?",
            "answer": "No. The Ritual Kit contains four uses of one cream mask, rather than four different products.",
            "show_for": "kit"
          }
        },
        "faq_9": {
          "type": "faq",
          "settings": {
            "question": "How is the kit different from the full size?",
            "answer": "The Ritual Kit introduces Sunday Reset in four individually packed uses. The full-size mask is the larger format for your routine.",
            "show_for": "both"
          }
        },
        "faq_10": {
          "type": "faq",
          "settings": {
            "question": "Where can I learn about the ingredients?",
            "answer": "Explore The Good Inside on this page. The ingredient library link will be added when that page exists.",
