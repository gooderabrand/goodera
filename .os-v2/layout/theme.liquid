<!doctype html>
{%- capture dir -%}
  {%- case request.locale.iso_code -%}
    {%- when 'ae' or 'ar' or 'arc' or 'bcc' or 'bqi' or 'ckb' or 'dv' or 'fa' or 'glk' or 'ha' or 'he' or 'he-IL' or 'kwh' or 'ks' or 'ku' or 'mzn' or 'nqo' or 'pnb' or 'ps' or 'sd' or 'ug' or 'ur' or 'yi' -%}
      rtl
    {%- else -%}
      ltr
  {%- endcase -%}
{%- endcapture -%}
<html lang="{{ request.locale.iso_code }}" dir="{{ dir }}">
  <head>
    <meta charset="utf-8">
    {%- if template.name == '404' -%}
      {%- liquid
        assign missing_path = request.path | split: '?' | first
        if missing_path == '/pages/shop' or missing_path == '/pages/shop/'
          assign redirect_shop_home = true
        endif
      -%}
      {%- if redirect_shop_home -%}
        <meta http-equiv="refresh" content="0;url={{ routes.root_url }}">
        <script>window.location.replace({{ routes.root_url | json }});</script>
      {%- endif -%}
    {%- endif -%}
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_body_bg | default: settings.color_background | default: '#FFFFFF' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {% render 'theme-fonts' %}
    {% render 'head-preload' %}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'good-era-favicon.svg' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'social-meta-tags' %}

    {{ 'app.css' | asset_url | stylesheet_tag }}
    {% render 'head-variables' %}

    {% style %}
      :root {
        --ge-bg: {{ settings.color_body_bg | default: '#FFFFFF' }};
        /* Cool grey surface — do not reuse body bg or cream defaults */
        --ge-surface: #f5f5f7;
        --ge-card: #f5f5f7;
        --ge-parchment: #f5f5f7;
        --ge-text: {{ settings.color_body | default: '#17160F' }};
        --ge-muted: #6e6e73;
        --ge-border: {{ settings.color_border | default: '#E5E5EA' }};
        --ge-accent: {{ settings.color_accent | default: '#6E7B5E' }};
      }
    {% endstyle %}

    {{ 'good-era-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'ge-shell.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'component-rail.css' | asset_url | stylesheet_tag }}
    {{ 'product-grid-ge.css' | asset_url | stylesheet_tag }}
    {{ 'commerce-shell.css' | asset_url | stylesheet_tag }}
    {{ 'ge-reformation-bridge.css' | asset_url | stylesheet_tag }}
    {{ 'discover.css' | asset_url | stylesheet_tag }}
    {{ 'commerce-ge.css' | asset_url | stylesheet_tag }}
    {%- if template.name == 'product' and template.suffix == 'clothing' -%}
      {{ 'product-clothing.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    {%- if template.name == 'product' -%}
      <style>
        /* Hide Shop Pay on product pages only — checkout still offers Shop Pay. */
        .product-form .shopify-payment-button__button--shop-pay,
        .product-form .shopify-payment-button__button--branded {
          display: none !important;
        }
      </style>
    {%- endif -%}
    {%- if template.suffix == 'sunday-reset-3d' or template.suffix == 'sunday-reset-application' -%}
      {{ 'sunday-reset-theme.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    <script>
      window.theme = window.theme || {};
      theme = {
        settings: {
          money_with_currency_format: {{- shop.money_format | json -}},
          cart_drawer: {{- settings.cart_drawer | json -}},
          product_id: {% if product %}{{ product.id }}{% else %}false{% endif %},
          collection_id: {% if collection %}{{ collection.id }}{% else %}false{% endif %}
        },
        routes: {
          root_url: '{{ routes.root_url }}',
          cart_url: '{{ routes.cart_url }}',
          cart_add_url: '{{ routes.cart_add_url }}',
          search_url: '{{ routes.search_url }}',
          cart_change_url: '{{ routes.cart_change_url }}',
          cart_update_url: '{{ routes.cart_update_url }}',
          cart_clear_url: '{{ routes.cart_clear_url }}',
          predictive_search_url: '{{ routes.predictive_search_url }}'
        },
        variantStrings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          preOrder: {{ 'products.product.pre_order' | t | json }}
        },
        strings: {
          requiresTerms: {{ 'sections.cart.terms_confirm' | t | json }},
          shippingEstimatorNoResults: {{ 'sections.cart.shipping_estimator.no_results' | t | json }},
          shippingEstimatorOneResult: {{ 'sections.cart.shipping_estimator.one_result' | t | json }},
          shippingEstimatorMultipleResults: {{ 'sections.cart.shipping_estimator.multiple_results' | t | json }},
          shippingEstimatorError: {{ 'sections.cart.shipping_estimator.error' | t | json }}
        }
      };
    </script>

    {% render 'ge-instafeed-corners' %}
    {{ content_for_header }}

    <script src="{{ 'component-rail.js' | asset_url }}" defer></script>
    <script src="{{ 'playlist-follow.js' | asset_url }}" defer></script>
  </head>
  {%- liquid
    assign ge_nav = settings.desktop_navigation | default: 'sidebar'
    if ge_nav != 'horizontal'
      assign ge_nav = 'sidebar'
    endif
    assign ge_header_chrome = settings.header_chrome | default: 'above'
    if ge_header_chrome != 'dark' and ge_header_chrome != 'over-media' and ge_header_chrome != 'above'
      assign ge_header_chrome = 'above'
    endif
    assign ge_page_kind = blank
    # Homepage is the Shop hub
    if template.name == 'index'
      assign ge_page_kind = 'shop'
    elsif template.name == 'page' and template.suffix == 'sunday-reset-3d'
      assign ge_page_kind = 'sunday-reset'
    elsif template.name == 'page' and template.suffix == 'discover'
      assign ge_page_kind = 'discover-hub'
    elsif template.name == 'page' and template.suffix == 'shop'
      assign ge_page_kind = 'shop'
    elsif template.name == 'page' and template.suffix == 'explore'
      assign ge_page_kind = 'explore-hub'
    elsif template.name == 'page' and template.suffix == 'events'
      assign ge_page_kind = 'explore-hub'
    elsif template.name == 'page' and template.suffix == 'about'
      assign ge_page_kind = 'about'
    elsif template.name == 'explore_category' or template.suffix == 'explore_category'
      assign ge_page_kind = 'explore-category'
    elsif template.name == 'discover_playlist' or template.suffix == 'discover_playlist'
      # Metaobject templates report the type as template.name
      assign ge_page_kind = 'discover-playlist'
    elsif template.name == 'discover_item' or template.suffix == 'discover_item'
      assign ge_page_kind = 'discover-item'
    elsif template.name == 'discover_series' or template.suffix == 'discover_series'
      assign ge_page_kind = 'discover-series'
    endif
    assign ge_header_tone = 'light'
    if ge_header_chrome == 'dark'
      assign ge_header_tone = 'dark'
    elsif ge_header_chrome == 'over-media'
      if ge_page_kind == 'explore-hub' or ge_page_kind == 'explore-category'
        assign ge_header_tone = 'light'
      else
        assign ge_header_tone = 'dark'
      endif
    endif
  -%}
  <body
    class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}{% if ge_page_kind != blank %} ge-page-{{ ge_page_kind }}{% endif %} ge-nav-{{ ge_nav }} ge-header-{{ ge_header_chrome }} animations-{{ settings.animations }} button-uppercase-{{ settings.button_uppercase }} product-card-spacing-{{ settings.product_card_spacing }}"
    {% if ge_page_kind != blank %}data-ge-page="{{ ge_page_kind }}"{% endif %}
    data-ge-nav="{{ ge_nav }}"
    data-ge-header-tone="{{ ge_header_tone }}"
  >
    {%- if request.page_type == 'password' -%}
      {{ 'password-coming-soon.css' | asset_url | stylesheet_tag }}
      {{ content_for_layout }}
    {%- else -%}
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    <div class="app-shell">
      {% sections 'sidebar-group' %}

      <div class="app-shell__main">
        {% sections 'header-group' %}

        <main id="MainContent" class="main-content" role="main" tabindex="-1">
          {{ content_for_layout }}
        </main>

        {% sections 'footer-group' %}
      </div>
    </div>

    {% render 'cart-drawer' %}
    {% render 'product-drawer' %}
    {% render 'search-drawer' %}
    <div class="click-capture"></div>
    {%- endif -%}

    {{ 'vendor.min.js' | asset_url | script_tag }}
    {{ 'slideshow.js' | asset_url | script_tag }}
    {{ 'app.js' | asset_url | script_tag }}

    {%- liquid
      assign add_product_js = false
      if template.name == 'product' or template.name == 'metaobject'
        assign add_product_js = true
      endif
      if settings.enable_quick_view or settings.enable_quick_add
        assign add_product_js = true
      endif
      if cart != empty and settings.cart_recommendations
        assign add_product_js = true
      endif
    -%}
    {% if add_product_js %}
      <script src="{{ 'product.js' | asset_url }}" defer="defer"></script>
    {% endif %}
    <script type="module" src="{{ 'scroll-shadow.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'ge-nav.js' | asset_url }}" defer="defer"></script>
    {%- if settings.free_shipping -%}
      {{ 'free-shipping.js' | asset_url | script_tag }}
      {{ 'free-shipping.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    {%- if settings.cart_drawer_add_discounts -%}
      {{ 'cart-discounts.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    {%- if settings.cart_recommendations -%}
      <script src="{{ 'product-recommendations.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {{ 'instafeed.css' | asset_url | stylesheet_tag }}
    {%- if template.name == 'product' and template.suffix == 'clothing' -%}
      <script src="{{ 'product-paired.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
  </body>
</html>
