{%- liquid
	assign full_height = section.settings.full_height

	assign background_image = section.settings.background_image
	assign color_bg = section.settings.color_bg
	assign color_text = section.settings.color_text
	assign color_border = section.settings.color_border
	assign color_input_border = section.settings.color_input_border
	
	assign video = section.settings.video
	assign video_hosted = section.settings.video_hosted
	assign video_fallback_image = section.settings.video_fallback_image
	assign logo_position = section.settings.logo_position
-%}
<div class="password-container password-container--full-height-{{ full_height }}" style="--color-bg: {{ color_bg }}; --color-body: {{ color_text }}; --color-body-rgb: {{ color_text.rgb | replace: ' ' , ',' }}; --color-accent: {{ color_text }}; --color-border: {{ color_border }}; --color-form-border: {{ color_input_border }};">
	
	<!-- Video Background -->
	{%- if video != blank or video_hosted != blank -%}
		<div class="password-video-background">
			{%- if video_fallback_image != blank -%}
				<div class="password-video-fallback">
					<img data-src="{{ video_fallback_image | image_url }}" alt="{{ video_fallback_image.alt | escape }}" width="{{ video_fallback_image.width }}" height="{{ video_fallback_image.height }}" class="lazyload{% unless settings.lazy_loading %} no-blur{% endunless %}" />
					<noscript>
						<img src="{{ video_fallback_image | image_url }}" alt="{{ video_fallback_image.alt | escape }}" width="{{ video_fallback_image.width }}" height="{{ video_fallback_image.height }}" />
					</noscript>
				</div>
			{%- endif -%}
			
			<div class="password-video-iframe" data-provider="{{ video.type }}">
				{%- if video_hosted == blank -%}
					{%- if video != blank -%}
						{%- if video.type == 'youtube' -%}
							<iframe data-src="https://www.youtube.com/embed/{{ video.id }}?loop=1&autoplay=1&mute=1&playlist={{ video.id }}&iv_load_policy=3&disablekb=1&controls=0&playsinline=1&enablejsapi=1" frameborder="0" class="lazyload" allow="autoplay; encrypted-media" allowfullscreen title="Background video" tabindex="-1"></iframe>
						{%- else -%}
							<iframe data-src="https://player.vimeo.com/video/{{ video.id }}?background=1" frameborder="0" class="lazyload" allow="autoplay; encrypted-media" allowfullscreen title="Background video" tabindex="-1"></iframe>
						{%- endif -%}
					{%- endif -%}
				{%- else -%}
					{{ video_hosted | video_tag: autoplay: true, loop: true, controls: false, muted: true }}
				{%- endif -%}
			</div>
			<div class="password-video-overlay" style="--overlay-opacity: {{ section.settings.video_overlay_opacity | divided_by: 100.00 }}"></div>
		</div>
	{%- endif -%}
	
	<!-- Static Background Image (fallback when no video) -->
	{%- if background_image and video == blank and video_hosted == blank -%}
		<div class="password-container--bg">
		{%- liquid
			assign small_width = background_image.src.height | times: '375' | divided_by: background_image.src.width
			assign master_width = background_image.src.width | append: 'x' | append: background_image.src.height
			assign width = '375x' | append: small_width | append: ',' | append: master_width
		-%}
		{%- render 'responsive-image', image: background_image, sizes: width -%}
		</div>
	{%- endif -%}
	
		<div class="password-header password-header--{{ logo_position }}">
		<div class="row expanded">
			<div class="small-12 columns">
				{%- if section.settings.logo -%}
					<a class="logolink" href="{{ routes.root_url }}">
						<img
							src="{{ section.settings.logo | image_url }}"
							class="logoimg"
							alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
							width="{{ section.settings.logo_max_width }}"
							height="{{ section.settings.logo_max_height }}"
						>
					</a>
				{%- else -%}
					<a class="logolink text-logo" href="{{ routes.root_url }}">
						{{ shop.name }}
					</a>
				{%- endif -%}
			</div>
		</div>
	</div>
	
	{%- style -%}
		:root {
			--logo-height: {{ section.settings.logo_max_height | append: 'px' }};
			--logo-height-mobile: {{ section.settings.logo_max_height | append: 'px' }};
		}
	{%- endstyle -%}
	
	<div class="row">
		<div class="small-12 columns">
			{% if section.settings.login_link == true %}
				<aside id="password-page-login" class="password-page-login password-page-login--{{ logo_position }}">
		      <h2>{{ 'sections.password.enter_using' | t }}</h2>
		      {% form 'storefront_password' %}
						{% capture form_errors %}
							{% if form.errors %}
							<div class="form-notification error">
								{% render 'svg-icons' with 'thb-error' %} {{ form.errors | default_errors }}
							</div>
							{% endif %}
						{% endcapture %}
						<fieldset>
			        <input class="password_field" type="password" name="password" id="password" autofocus="" autocomplete="current-password" />
			        <button class="submit" type="submit">{% render 'svg-icons' with 'signup-submit' %}</button>
						</fieldset>
						{{ form_errors }}
		      {% endform %}
		      <p class="store-owner">{{ 'sections.password.are_you_the_store_owner' | t }} <a href="/admin" class="text-button">{{ 'sections.password.login_here' | t }}</a></p>
					<p class="cancel"><a href="#" class="text-button">{{ 'sections.password.cancel' | t }}</a></p>
				</aside>
			{% endif %}
			<div class="password-content password-content--{{ logo_position }}">
				<h1>{{ 'sections.password.opening_soon' | t }}</h1>
				{% if shop.password_message and shop.password_message != blank %}
		      <p>{{ shop.password_message }}</p>
		    {% endif %}
				{% if section.settings.subscription_form == true %}
					<div class="signup-container">
						{% form 'customer', class: 'signup-form' %}
							{% capture form_errors %}
								{% if form.errors %}
								<div class="form-notification error">
									{% render 'svg-icons' with 'thb-error' %} {{ form.errors | default_errors }}
								</div>
								{% endif %}
							{% endcapture %}
							<fieldset>
								<input id="contact_tags" name="contact[tags]" type="hidden" value="prospect,newsletter" />
								<div class="field">
									<input
										placeholder="{{ 'newsletter.label' | t }}"
										type="email"
										id="contact_email--{{ section.id }}"
										name="contact[email]"
										autocorrect="off"
										autocapitalize="off"
										autocomplete="email"
										pattern="^([a-zA-Z0-9_\-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$"
										title="xxx@xxx.xxx"
										{% if form.errors %}
											autofocus
											aria-invalid="true"
											aria-describedby="contact_email"
										{% elsif form.posted_successfully? %}
											aria-describedby="contact_email"
										{% endif %}
										required
									/>
									<label class="field__label" for="contact_email--{{ section.id }}">
						        {{ 'newsletter.label' | t }}
						      </label>
									<button class="widget_subscribe_btn submit" type="submit" aria-label="{{ 'sections.signup.enter_your_email' | t }}">{% render 'svg-icons' with 'signup-submit' %}</button>
								</div>
							</fieldset>
						{% endform %}
					</div>
					{{ form_errors }}
				{% endif %}
				{%- if section.settings.social_links -%}
				{% render 'social-links' %}
				{%- endif -%}
				
				{% if section.settings.login_link == true %}
				<div class="password-login-bottom">
					<a href="#password-page-login" class="password-login-link-bottom">{% render 'svg-icons' with 'lock' %} {{ 'sections.password.login_using' | t }}</a>
				</div>
				{% endif %}
			</div>
		</div>
	</div>
</div>

<style>
.password-video-background {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: -1;
  overflow: hidden;
}

.password-video-fallback {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: -1;
}

.password-video-fallback img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.password-video-iframe {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
}

.password-video-iframe > video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.password-video-iframe iframe {
  position: absolute;
  z-index: 1;
  width: 100%;
  height: 100%;
  left: 0;
  top: 0;
}

.password-video-iframe video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.password-video-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  background: rgba(0, 0, 0, var(--overlay-opacity));
}

.password-header--center .columns {
  justify-content: center;
  text-align: center;
}

.password-header--center .password-login-link {
  margin-top: 15px;
}

@media only screen and (min-width: 768px) {
  .password-header--center .password-login-link {
    margin-top: 0;
    margin-left: 30px;
  }
}

.password-header--right .columns {
  justify-content: flex-end;
  text-align: right;
}

.password-header--right .password-login-link {
  margin-top: 15px;
}

@media only screen and (min-width: 768px) {
  .password-header--right .password-login-link {
    margin-top: 0;
    margin-left: 30px;
  }
}

/* Content positioning based on logo position */
.password-content--left {
  text-align: left;
}

.password-content--center {
  text-align: center;
}

.password-content--right {
  text-align: right;
}

.password-page-login--left {
  text-align: left;
}

.password-page-login--center {
  text-align: center;
}

.password-page-login--right {
  text-align: right;
}

.password-logo--svg {
  filter: brightness(0) invert(1);
}
</style>

{% schema %}
  {
    "name": "Password page",
    "settings": [
			{
				"type": "image_picker",
				"id": "logo",
				"label": "Logo image",
				"info": "200 x 80px .png or .svg recommended"
			},
			{
				"type": "range",
				"id": "logo_max_height",
				"min": 20,
				"max": 120,
				"step": 1,
				"default": 30,
				"unit": "px",
				"label": "Custom logo height"
			},
			{
				"type": "range",
				"id": "logo_max_width",
				"min": 50,
				"max": 300,
				"step": 10,
				"default": 200,
				"unit": "px",
				"label": "Custom logo width"
			},
			{
				"type": "select",
				"id": "logo_position",
				"label": "Logo position",
				"options": [
					{
						"value": "left",
						"label": "Left"
					},
					{
						"value": "center",
						"label": "Center"
					},
					{
						"value": "right",
						"label": "Right"
					}
				],
				"default": "left"
			},
			{
				"type": "header",
				"content": "Video Background"
			},
			{
				"type": "video_url",
				"id": "video",
				"label": "Video URL",
				"accept": [
					"youtube",
					"vimeo"
				],
				"placeholder": "Use a YouTube or Vimeo URL",
				"info": "Video will play in background. Leave empty to use static image."
			},
			{
				"type": "video",
				"id": "video_hosted",
				"label": "Shopify-hosted video",
				"info": "Overrides the Video URL setting."
			},
			{
				"type": "image_picker",
				"id": "video_fallback_image",
				"label": "Video fallback image",
				"info": "1920 x 1080 px .jpg recommended. Shows while video loads."
			},
			{
				"type": "range",
				"id": "video_overlay_opacity",
				"min": 0,
				"max": 100,
				"step": 5,
				"unit": "%",
				"label": "Video overlay opacity",
				"default": 25
			},
			{
         "type": "checkbox",
         "id": "full_height",
         "default": true,
         "label": "Make section full height"
      },
			{
				"type": "header",
				"content": "Content"
			},
			{
				"type": "paragraph",
				"content": "Customize your message in the 'Preferences' section of your Online Store. [Learn more](https://help.shopify.com/en/manual/online-store/themes/password-page#add-password-protection-to-your-online-store)"
			},
      {
         "type": "checkbox",
         "id": "subscription_form",
         "default": true,
         "label": "Display signup form",
				 "info": "Each email subscription creates a customer account. [Learn more](https://help.shopify.com/en/manual/customers)"
      },
			{
         "type": "checkbox",
         "id": "social_links",
         "default": true,
         "label": "Display social links"
      },
      {
         "type": "checkbox",
         "id": "login_link",
         "default": true,
         "label": "Display login link"
      },
			{
        "type": "header",
        "content": "Static Background (when no video)"
      },
			{
				"type": "image_picker",
				"id": "background_image",
				"label": "Background image",
				"info": "1600 x 900px .jpg recommended. Only shows when no video is selected."
			},
			{
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "transparent"
      },
			{
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#151515"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Lines and borders",
        "default": "#E2E2E2"
      },
      {
        "type": "color",
        "id": "color_input_border",
        "label": "Input borders",
        "default": "#dedede"
      }
    ]
  }

{% endschema %}
