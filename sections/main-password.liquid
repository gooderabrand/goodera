{%- liquid
	assign full_height = section.settings.full_height

	assign background_image = section.settings.background_image
	assign color_bg = section.settings.color_bg
	assign color_text = section.settings.color_text
	assign color_border = section.settings.color_border
	assign color_input_border = section.settings.color_input_border
	
	assign video = section.settings.video
	assign video_hosted = section.settings.video_hosted
	assign fallback_image = section.settings.fallback_image
	assign overlay_opacity = section.settings.overlay_opacity
-%}
<div class="password-container password-container--full-height-{{ full_height }}" style="--color-bg: {{ color_bg }}; --color-body: {{ color_text }}; --color-body-rgb: {{ color_text.rgb | replace: ' ' , ',' }}; --color-accent: {{ color_text }}; --color-border: {{ color_border }}; --color-form-border: {{ color_input_border }};">
	<div class="password-header">
		<div class="row expanded">
			<div class="small-12 columns">
								{%- if section.settings.logo -%}
					<a class="logolink" href="{{ routes.root_url }}">
						<img
							src="{{ section.settings.logo | image_url }}"
							class="password-logo"
							alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
							style="max-height: {{ section.settings.logo_max_height }}px"
							width="{{ section.settings.logo.width }}"
							height="{{ section.settings.logo.height }}"
							loading="lazy"
						>
					</a>
			  {%- else -%}
					<a class="logolink text-logo" href="{{ routes.root_url }}">
						{{ shop.name }}
					</a>
			  {%- endif -%}
				{% if section.settings.login_link == true %}
				<a href="#password-page-login" class="password-login-link">{% render 'svg-icons' with 'lock' %} {{ 'sections.password.login_using' | t }}</a>
				{% endif %}
			</div>
		</div>
	</div>
	
	<!-- Hero Banner Background -->
	<div class="password-hero-background">
		{%- if fallback_image != blank -%}
		<div class="password-hero-background__fallback-img">
			<img data-src="{{ fallback_image | image_url }}" alt="{{ fallback_image.alt | escape }}" width="{{ fallback_image.width }}" height="{{ fallback_image.height }}" class="lazyload{% unless settings.lazy_loading %} no-blur{% endunless %}" />
			<noscript>
			<img src="{{ fallback_image | image_url }}" alt="{{ fallback_image.alt | escape }}" width="{{ fallback_image.width }}" height="{{ fallback_image.height }}" />
			</noscript>
		</div>
		{%- endif -%}
		
		<div class="password-hero-background__video" data-provider="{{ video.type }}">
			{%- if video_hosted == blank -%}
				{%- if video != blank -%}
					{%- if video.type == 'youtube' -%}
						<iframe data-src="https://www.youtube.com/embed/{{ video.id }}?loop=1&autoplay=1&mute=1&playlist={{ video.id }}&iv_load_policy=3&disablekb=1&controls=0&playsinline=1&enablejsapi=1" frameborder="0" class="lazyload" allow="autoplay; encrypted-media" allowfullscreen title="{{ section.settings.heading | escape }}" tabindex="-1"></iframe>
					{%- else -%}
						<iframe data-src="https://player.vimeo.com/video/{{ video.id }}?background=1" frameborder="0" class="lazyload" allow="autoplay; encrypted-media" allowfullscreen title="{{ section.settings.heading | escape }}" tabindex="-1"></iframe>
					{%- endif -%}
				{%- endif -%}
			{%- else -%}
				{{ video_hosted | video_tag: autoplay: true, loop: true, controls: false, muted: true }}
			{%- endif -%}
		</div>
		
		<div class="password-hero-background__overlay" style="--overlay-opacity: {{ overlay_opacity | divided_by: 100.00 }}"></div>
	</div>
	
	{% if background_image %}
		<div class="password-container--bg">
		{%- liquid
			assign small_width = background_image.src.height | times: '375' | divided_by: background_image.src.width
			assign master_width = background_image.src.width | append: 'x' | append: background_image.src.height
			assign width = '375x' | append: small_width | append: ',' | append: master_width
		-%}
		{%- render 'responsive-image', image: background_image, sizes: width -%}
		</div>
	{% endif %}
	
	<div class="row">
		<div class="small-12 columns">
			{% if section.settings.login_link == true %}
				<aside id="password-page-login" class="password-page-login">
		      <h2>{{ 'sections.password.enter_using' | t }}</h2>
		      {% form 'storefront_password' %}
						{% capture form_errors %}
							{% if form.errors %}
							<div class="form-notification error">
								{% render 'svg-icons' with 'thb-error' %} {{ form.errors | default_errors }}
							</div>
							{% endif %}
						{% endcapture %}
						<fieldset>
			        <input class="password_field" type="password" name="password" id="password" autofocus="" autocomplete="current-password" />
			        <button class="submit" type="submit">{% render 'svg-icons' with 'signup-submit' %}</button>
						</fieldset>
						{{ form_errors }}
		      {% endform %}
		      <p class="store-owner">{{ 'sections.password.are_you_the_store_owner' | t }} <a href="/admin" class="text-button">{{ 'sections.password.login_here' | t }}</a></p>
					<p class="cancel"><a href="#" class="text-button">{{ 'sections.password.cancel' | t }}</a></p>
				</aside>
			{% endif %}
			<div class="password-content">
				<h1>{{ 'sections.password.opening_soon' | t }}</h1>
				{% if shop.password_message and shop.password_message != blank %}
		      <p>{{ shop.password_message }}</p>
		    {% endif %}
				{% if section.settings.subscription_form == true %}
					<div class="signup-container">
						<div class="klaviyo-form-XDtn9Y"></div>
						<script async type="text/javascript" src="https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=XDtn9Y"></script>
					</div>
				{% endif %}
				{%- if section.settings.social_links -%}
				{% render 'social-links' %}
				{%- endif -%}
				<p class="shopify-copyright">{{ powered_by_link }}</p>
			</div>
		</div>
	</div>
</div>
{% schema %}
  {
    "name": "Password page",
    "settings": [
			{
				"type": "image_picker",
				"id": "logo",
				"label": "Logo image",
				"info": "200 x 80px .png or .svg recommended"
			},
			{
				"type": "range",
				"id": "logo_max_height",
				"min": 20,
				"max": 120,
				"step": 1,
				"default": 30,
				"unit": "px",
				"label": "Custom logo height"
			},
			{
         "type": "checkbox",
         "id": "full_height",
         "default": true,
         "label": "Make section full height"
      },
			{
				"type": "header",
				"content": "Hero Background"
			},
			{
				"type": "video_url",
        "id": "video",
        "label": "Video URL",
				"accept": [
          "youtube",
          "vimeo"
        ],
				"placeholder": "Use a YouTube or Vimeo URL",
				"info": "Video will play in background with fallback image"
			},
			{
			  "type": "video",
			  "id": "video_hosted",
			  "label": "Shopify-hosted video",
				"info": "Overrides the Video URL setting."
			},
			{
        "type": "image_picker",
        "id": "fallback_image",
        "label": "Fallback image",
				"info": "1920 x 1080 px .jpg recommended. Shows when video is loading or unavailable."
      },
			{
				"type": "range",
				"id": "overlay_opacity",
				"min": 0,
				"max": 100,
				"step": 5,
				"unit": "%",
				"label": "Overlay opacity",
				"default": 25,
				"info": "Darkens the background to improve text readability"
			},
			{
				"type": "header",
				"content": "Content"
			},
			{
				"type": "paragraph",
				"content": "Customize your message in the 'Preferences' section of your Online Store. [Learn more](https://help.shopify.com/en/manual/online-store/themes/password-page#add-password-protection-to-your-online-store)"
			},
      {
         "type": "checkbox",
         "id": "subscription_form",
         "default": true,
         "label": "Display signup form",
				 "info": "Each email subscription creates a customer account. [Learn more](https://help.shopify.com/en/manual/customers)"
      },
			{
         "type": "checkbox",
         "id": "social_links",
         "default": true,
         "label": "Display social links"
      },
      {
         "type": "checkbox",
         "id": "login_link",
         "default": true,
         "label": "Display login link"
      },
			{
        "type": "header",
        "content": "General"
      },
			{
				"type": "image_picker",
				"id": "background_image",
				"label": "Background image",
				"info": "1600 x 900px .jpg recommended"
			},
			{
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "transparent"
      },
			{
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#151515"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Lines and borders",
        "default": "#E2E2E2"
      },
      {
        "type": "color",
        "id": "color_input_border",
        "label": "Input borders",
        "default": "#dedede"
      }
    ]
  }

{% endschema %}
