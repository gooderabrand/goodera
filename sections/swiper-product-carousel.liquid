{% comment %}
  Swiper Product Carousel Section
{% endcomment %}

{% comment %}
  Assign section settings
{% endcomment %}
{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.product_limit
  assign columns_desktop = section.settings.columns_desktop
  assign show_arrows = section.settings.show_arrows
  assign show_pagination = section.settings.show_pagination
  assign enable_autoplay = section.settings.enable_autoplay
  assign autoplay_delay = section.settings.autoplay_delay

  assign columns_class = 'small-6 medium-6 large-4'
  case columns_desktop
		when 2
			assign columns_class = 'small-6 medium-6'
		when 3
			assign columns_class = 'small-6 medium-4'
		when 4
			assign columns_class = 'small-6 medium-6 large-3'
    when 5
			assign columns_class = 'small-6 medium-4 large-2-5'
  endcase

  # Assign variables needed for product-card and product-card-variant snippets
  assign products_hover_images = settings.products_hover_images
  assign products_hover_images_count = settings.products_hover_images_count
  assign product_aspect_ratio = settings.product_aspect_ratio
  assign product_content_alignment = settings.product_content_alignment
  assign show_size_options = settings.show_size_options

-%}

{% comment %}
  Include Swiper assets (Assuming swiper-bundle.min.css and swiper-bundle.min.js are in your assets folder)
{% endcomment %}
{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}

<div class="swiper-section-container section-spacing{% if section.settings.disable_top_spacing %} section-spacing--disable-top{% endif %}{% if section.settings.disable_bottom_spacing %} section-spacing--disable-bottom{% endif %}">
  <div class="row{% if section.settings.full_width %} full-width-row{% endif %}">
    <div class="small-12 columns">
      {% comment %}
        Section header
      {% endcomment %}
      {% render 'section-header', section_heading: section.settings.heading, section_description: section.settings.description, section_heading_left: section.settings.heading_left %}

      <div class="featured-collection__inner" style="--columns-desktop: {{ columns_desktop }};">
        <div class="swiper-container">
          <div class="swiper-wrapper">
            {% comment %}
              Product slides - copied from featured-collection.liquid
            {% endcomment %}
            {%- if collection != blank -%}
						{%- for product in collection.products limit: products_to_show -%}
							{% assign lazy_load = false %}
							{%- if forloop.index > 2 -%}
								{%- assign lazy_load = true -%}
							{%- endif -%}

							{% assign has_color_option = false %}
                {% for option in product.options %}
                  {% assign option_name = option.name | downcase %}
                  {% if option_name contains 'color' or option_name contains 'colour' %}
                    {% assign has_color_option = true %}
                    {% assign color_option_index = forloop.index0 %}
                    {% break %}
                  {% endif %}
                {% endfor %}

							{% if has_color_option %}
								{% assign colorlist = '' %}
								{% for variant in product.variants %}
									{% capture color %}
										{{ variant.options[color_option_index] }}
									{% endcapture %}
									{% unless colorlist contains color %}
										<div class="swiper-slide">
											<div class="{{ columns_class }} columns">
												{% render 'product-card-variant',
													card_product: variant,
													title: product.title,
													color: color,
													lazy_load: lazy_load,
													parent_product: product
												%}
											</div>
										</div>
										{% capture tempList %}
											{{colorlist | append: color | append: " " }}
										{% endcapture %}
										{% assign colorlist = tempList %}
									{% endunless %}
								{% endfor %}
							{% else %}
							<div class="swiper-slide">
								<div class="{{ columns_class }} columns">
									{% render 'product-card', product_card_product: product %}
								</div>
							</div>
							{% endif %}
						{%- endfor -%}
					{%- else -%}
						{% comment %}
							Placeholder slides if no collection is selected
						{% endcomment %}
						{%- for i in (1..products_to_show) -%}
						<div class="swiper-slide">
							<div class="{{ columns_class }} columns">
								{% render 'product-card' %}
							</div>
						</div>
						{%- endfor -%}
					{%- endif -%}
          </div>

          {% comment %}
            Add Swiper navigation, pagination, etc. here if needed
          {% endcomment %}
          {% if show_pagination %}<div class="swiper-pagination"></div>{% endif %}
          {% if show_arrows %}
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% comment %}
  Initialize Swiper (Assuming swiper-bundle.min.js is in your assets folder)
{% endcomment %}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const swiper = new Swiper('.swiper-container', {
      // Optional parameters
      loop: true,
      grabCursor: true,
      // Disable snap and freeMode for more controlled sliding based on slidesPerView
      snap: false,
      freeMode: false,

      autoplay: {{ enable_autoplay }} ? { delay: {{ autoplay_delay | default: 5000 }} } : false,

      // If we need pagination
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },

      // Navigation arrows
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },

      // Responsive breakpoints
      breakpoints: {
        // when window width is < 768px (mobile)
        0: {
          slidesPerView: 2, // Default to 2 columns on mobile
          spaceBetween: 0 // Let theme CSS handle spacing
        },
        // when window width is >= 768px (tablet)
        768: {
          slidesPerView: 3, // Default to 3 columns on tablet
          spaceBetween: 0 // Let theme CSS handle spacing
        },
        // when window width is >= 1024px (desktop)
        1024: {
          slidesPerView: {{ columns_desktop }}, // Use columns_desktop setting for desktop
          spaceBetween: 0 // Let theme CSS handle spacing
        }
      }
    });
  });
</script>

{% schema %}
{
  "name": "Swiper Product Carousel",
  "class": "section-swiper-product-carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collection"
    },
    {
      "type": "checkbox",
      "id": "heading_left",
      "default": false,
      "label": "Left align heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": true
    },
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Maximum products to show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Number of columns on desktop"
    },
    {
      "type": "header",
      "content": "Carousel options"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 3000,
      "max": 9500,
      "step": 500,
      "label": "Autoplay delay (ms)",
      "default": 5000,
      "unit": "ms"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "disable_top_spacing",
      "default": false,
      "label": "Remove top spacing"
    },
    {
      "type": "checkbox",
      "id": "disable_bottom_spacing",
      "default": false,
      "label": "Remove bottom spacing"
    }
  ],
  "presets": [
    {
      "name": "Swiper Product Carousel"
    }
  ],
  "enabled_on": {
    "templates": ["*"],
    "groups": [
      "header", "footer"
    ]
  }
}
{% endschema %} 