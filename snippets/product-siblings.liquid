{%- liquid
  assign metafields = metafields | default: false
  assign show_siblings = false
  assign sibs_collection = siblings_collection | default: block.settings.siblings_collection | default: false
  assign sibling_color_param = sibling_color | default: block.settings.sibling_color | default: product.metafields.theme.sibling_color.value | default: product.metafields.theme.sibling_colour.value | default: product.metafields.theme.siblings_color.value | default: product.metafields.theme.siblings_colour.value | default: product.metafields.theme.siblings_colors.value | default: product.metafields.theme.siblings_colours.value
  assign color_picker_size_param = color_picker_size | default: block.settings.color_picker_size | default: 'regular'
  assign margin_bottom_param = margin_bottom | default: block.settings.margin_bottom | default: 0

  if metafields
    assign sibs_collection = product.metafields.theme.sibling_products.value | default: collections[product.metafields.theme.siblings.value].products
  else
    assign sibs_collection = collections[sibs_collection].products
  endif

  if metafields and sibs_collection != blank
    assign show_siblings = true
  elsif metafields == false and sibs_collection and sibs_collection.size > 0
    assign show_siblings = true
  endif
-%}

{%- if show_siblings -%}
  {%- if product_form_id == blank or product_form_id == nil -%}
    {%- comment -%} Product card context: use product-card-swatches markup {%- endcomment -%}
    {%- liquid
      assign custom_colors = settings.color_swatches | newline_to_br | split: '<br />'
      assign key_array = ''
      assign val_array = ''
      for color in custom_colors
        assign key = color | split: ':' | first | rstrip
        assign value = color | split: ':' | last | lstrip
        assign key_array = key_array | append: ',' | append: key
        assign val_array = val_array | append: ',' | append: value
      endfor
      assign key_array = key_array | remove_first: ',' | strip_newlines | downcase | split: ','
      assign val_array = val_array | remove_first: ',' | split: ','
      assign variant_image_size = '40'
      case color_picker_size_param
        when 'large'
          assign variant_image_size = '72'
        when 'xlarge'
          assign variant_image_size = '104'
      endcase
    -%}
    <div class="product-card-swatches--container no-js-hidden">
      <div class="product-card-swatches product-card-swatches--hover" data-index="0">
        {%- for sib_product in sibs_collection limit: 50 -%}
          {%- liquid
            assign color_value = sib_product.metafields.theme.sibling_color.value | default: sib_product.metafields.theme.sibling_colour.value | default: sib_product.metafields.theme.siblings_color.value | default: sib_product.metafields.theme.siblings_colour.value | default: sib_product.metafields.theme.siblings_colors.value | default: sib_product.metafields.theme.siblings_colours.value
            assign color_value = color_value | downcase
            for custom_color in key_array
              if custom_color == color_value
                assign color_value = val_array[forloop.index0]
              endif
            endfor
            assign bg_value = empty
            if color_value contains '.'
              assign bg_value = color_value | file_url
              assign color_value = 'var(--bg-body)'
            endif
            if settings.sibling_style == 'image'
              assign bg_value = sib_product.featured_media.preview_image | image_url: width: variant_image_size
            endif
            assign active = ''
            if sib_product.handle == product.handle
              assign active = 'active'
            endif
            assign variant_image = sib_product.featured_media
            assign image_sizes = '375x375,770x770' | split: ','
            capture srcset
              if variant_image != blank
                for size in image_sizes
                  assign size_x = size
                  echo variant_image | img_url: size_x, crop: 'center'
                  echo ' '
                  echo size_x | split: 'x' | first
                  echo 'w,'
                endfor
              endif
            endcapture
            assign l = srcset | size | minus: 1
          -%}
          <div class="product-card-swatch {{ active }}" style="--option-color: {{ color_value | downcase | escape }};{%- if bg_value != empty -%} --option-color-image: url('{{ bg_value | escape }}');{%- endif -%}" data-srcset="{{- srcset | slice: 0, l | strip_newlines -}}" data-href="{{ sib_product.url }}">
            <span class="visually-hidden">{{ color_value }}</span>
          </div>
        {%- endfor -%}
      </div>
      <div class="product-card-swatches--title">{{ 'products.product.available' | t: count: sibs_collection.size }}</div>
    </div>
  {%- else -%}
    <div class="variations variations--siblings">
      {%- assign title_down = product.title | downcase -%}
      {%- assign sibling_down = sibling_color_param | downcase -%}
      {%- unless title_down contains sibling_down -%}
        <input type="hidden" form="{{ product_form_id }}" name="properties[{{ 'products.product.siblings.label' | t }}]" value="{{ sibling_color_param }}">
      {%- endunless -%}
      {%- liquid
        assign custom_colors = settings.color_swatches | newline_to_br | split: '<br />'
        assign key_array = ''
        assign val_array = ''
        for color in custom_colors
          assign key = color | split: ':' | first | rstrip
          assign value = color | split: ':' | last | lstrip
          assign key_array = key_array | append: ',' | append: key
          assign val_array = val_array | append: ',' | append: value
        endfor
        assign key_array = key_array | remove_first: ',' | strip_newlines | downcase | split: ','
        assign val_array = val_array | remove_first: ',' | split: ','
        assign variant_image_size = '40'
        case color_picker_size_param
          when 'large'
            assign variant_image_size = '72'
          when 'xlarge'
            assign variant_image_size = '104'
        endcase
      -%}
      {%- if sibs_collection -%}
        <fieldset class="product-form__input product-form__input--siblings product-form__input--siblings--{{ color_picker_size_param }}" style="--siblings-margin:{{ margin_bottom_param | append: 'px' }}">
          <div class="form__label">{{ 'products.product.siblings.label' | t }}: {% if sibling_color_param != blank -%}<span class="form__label__value">{{ sibling_color_param }}</span>{%- endif -%}</div>
          {%- for sib_product in sibs_collection limit: 50 -%}
            {%- liquid
              assign color_value = sib_product.metafields.theme.sibling_color.value | default: sib_product.metafields.theme.sibling_colour.value | default: sib_product.metafields.theme.siblings_color.value | default: sib_product.metafields.theme.siblings_colour.value | default: sib_product.metafields.theme.siblings_colors.value | default: sib_product.metafields.theme.siblings_colours.value
              assign color_value = color_value | downcase
              for custom_color in key_array
                if custom_color == color_value
                  assign color_value = val_array[forloop.index0]
                endif
              endfor
              assign bg_value = empty
              if color_value contains '.'
                assign bg_value = color_value | file_url
                assign color_value = 'var(--bg-body)'
              endif
              if settings.sibling_style == 'image'
                assign bg_value = sib_product.featured_media.preview_image | image_url: width: variant_image_size
              endif
            -%}
            <label class="{%- if sib_product.handle == product.handle -%}active{%- endif %}{%- if sib_product.available == false %} sold-out{%- endif %}" style="--option-color: {{ color_value | downcase | escape }}; {%- if bg_value != empty -%} --option-color-image: url('{{ bg_value | escape }}');{%- endif -%}">
              <a href="{{ sib_product.url }}" title="{{ sib_product.title | escape }}"></a>
            </label>
          {%- endfor -%}
        </fieldset>
        {%- assign size_option = false -%}
        {%- assign size_option_index = 0 -%}
        {%- for option in product.options_with_values -%}
          {%- if option.name contains 'Size' or option.name contains 'size' -%}
            {%- assign size_option = option -%}
            {%- assign size_option_index = forloop.index0 -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if size_option -%}
          <div class="variations">
            <fieldset class="product-form__input product-form__input--block">
              <div class="form__label">{{ size_option.name }}: <span class="form__label__value">{{ product.selected_or_first_available_variant.options[size_option_index] }}</span></div>
              {%- for value in size_option.values -%}
                {%- assign variant_for_size = false -%}
                {%- for variant in product.variants -%}
                  {%- if variant.options contains value -%}
                    {%- assign variant_for_size = variant -%}
                  {%- endif -%}
                {%- endfor -%}
                <input type="radio" id="sibling-size-{{ forloop.index }}" name="sibling-size" value="{{ variant_for_size.id }}" {% if variant_for_size.available == false %}disabled{% endif %} {% if variant_for_size.id == product.selected_or_first_available_variant.id %}checked{% endif %}>
                <label for="sibling-size-{{ forloop.index }}">{{ value }}</label>
              {%- endfor -%}
            </fieldset>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- endif -%}
{%- elsif request.design_mode -%}
  <div></div>
{%- endif -%}
