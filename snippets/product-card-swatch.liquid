{%- if settings.show_products_swatches -%}
	{%- assign swatch_style = settings.swatch_style -%}
	
	{%- liquid
		# Check for sibling products (related products with different colors)
		assign show_siblings = false
		assign sibs_collection = blank
		assign sibling_color = product.metafields.theme.sibling_color.value | default: product.metafields.theme.sibling_colour.value | default: product.metafields.theme.siblings_color.value | default: product.metafields.theme.siblings_colour.value | default: product.metafields.theme.siblings_colors.value | default: product.metafields.theme.siblings_colours.value
		
		# Try to find sibling products from metafields
		assign sibs_collection = product.metafields.theme.sibling_products.value | default: collections[product.metafields.theme.siblings.value].products
		
		if sibs_collection != blank and sibs_collection.size > 0
			assign show_siblings = true
		endif
	-%}
	
	{%- if show_siblings -%}
		{%- liquid
			assign custom_colors = settings.color_swatches | newline_to_br | split: '<br />'
			assign key_array = ''
			assign val_array = ''

			for color in custom_colors
				assign key = color | split: ':' | first | rstrip
				assign value = color | split: ':' | last | lstrip
				assign key_array = key_array | append: ',' | append: key
				assign val_array = val_array | append: ',' | append: value
			endfor

			assign key_array = key_array | remove_first: ',' | strip_newlines | downcase | split: ','
			assign val_array = val_array | remove_first: ',' | split: ','
		-%}
		
		<div class="product-card-swatches--container no-js-hidden">
			<fieldset class="product-form__input product-form__input--siblings" style="--siblings-margin: 10px;">
				{%- for sib_product in sibs_collection limit: 10 -%}
					{%- liquid
						assign color_value = sib_product.metafields.theme.sibling_color.value | default: sib_product.metafields.theme.sibling_colour.value | default: sib_product.metafields.theme.siblings_color.value | default: sib_product.metafields.theme.siblings_colour.value | default: sib_product.metafields.theme.siblings_colors.value | default: sib_product.metafields.theme.siblings_colours.value
						assign color_value = color_value | downcase

						for custom_color in key_array
							if custom_color == color_value
								assign color_value = val_array[forloop.index0]
							endif
						endfor

						assign bg_value = empty
						if color_value contains '.'
							assign bg_value = color_value | file_url
							assign color_value = 'var(--bg-body)'
						endif

						if settings.sibling_style == 'image'
							assign bg_value = sib_product.featured_media.preview_image | image_url: width: 40
						endif
					-%}
					{%- liquid
						# Try to find a variant image that matches the sibling color
						assign sibling_image = sib_product.featured_media.preview_image
						assign sibling_color_value = sib_product.metafields.theme.sibling_color.value | default: sib_product.metafields.theme.sibling_colour.value | default: sib_product.metafields.theme.siblings_color.value | default: sib_product.metafields.theme.siblings_colour.value | default: sib_product.metafields.theme.siblings_colors.value | default: sib_product.metafields.theme.siblings_colours.value
						
						# Look for a variant image that matches the sibling color
						# Try multiple matching approaches
						for variant in sib_product.variants
							if variant.image
								# Check if variant title contains the sibling color
								if variant.title contains sibling_color_value
									assign sibling_image = variant.image
									break
								endif
								# Also check if any option contains the color
								for option in variant.options
									if option contains sibling_color_value
										assign sibling_image = variant.image
										break
									endif
								endfor
								# Break outer loop if we found an image
								if sibling_image != sib_product.featured_media.preview_image
									break
								endif
							endif
						endfor
					-%}
					<label class="{%- if sib_product.handle == product.handle -%}active{%- endif %}{%- if sib_product.available == false %} sold-out{%- endif %}" 
						style="--option-color: {{ color_value | downcase | escape }}; {%- if bg_value != empty -%} --option-color-image: url('{{ bg_value | escape }}');{%- endif -%}">
						<a href="{{ sib_product.url }}" title="{{ sib_product.title | escape }}" 
						   data-srcset="{{ sibling_image | image_url: width: 375 }}, {{ sibling_image | image_url: width: 770 }}"></a>
					</label>
				{%- endfor -%}
			</fieldset>
		</div>
	{%- else -%}
		{%- unless product.has_only_default_variant -%}
		
		{%- liquid
			assign active_color_value = ''
			assign color_option = null

			# Find the color option
			for option in product.options_with_values
				assign option_name = option.name | downcase | escape
				if option_name contains 'color' or option_name contains 'colour' or option_name contains 'couleur' or option_name contains 'farbe'
					assign color_option = option
					break
				endif
			endfor

			# Get the color value from the selected or first available variant
			if color_option != null
				assign option_index = 'option' | append: color_option.position
				assign active_color_value = product.selected_or_first_available_variant[option_index]
			endif
		-%}
		{%- for option in product.options_with_values -%}
			{%- liquid
				assign option_name = option.name | downcase | escape 
				assign color_swatch = false

				if option_name contains 'color' or option_name contains 'colour' or option_name contains 'couleur' or option_name contains 'farbe'
					assign color_swatch = true
				endif
				
				# Additional swatch variant options set inside theme settings
				assign color_swatches_variant_option = settings.color_swatches_variant_option | downcase | split: ', '

				if color_swatches_variant_option contains option_name
					assign color_swatch = true
				endif
			-%}
			{%- if color_swatch -%}
				{%- liquid
				assign color_index = forloop.index0
				assign custom_colors = settings.color_swatches | newline_to_br | split: '<br />'
				assign key_array = ''
				assign val_array = ''

				for color in custom_colors
					assign key = color | split: ':' | first | rstrip
					assign value = color | split: ':' | last | lstrip
					assign key_array = key_array | append: ',' | append: key
					assign val_array = val_array | append: ',' | append: value
				endfor

				assign key_array = key_array | remove_first: ',' | strip_newlines | downcase | split: ','
				assign val_array = val_array | remove_first: ',' | split: ','
				-%}
				{% if option.values.size > 1 %}
				<fieldset class="product-card-swatches--container product-form__input product-form__input--siblings no-js-hidden" data-index="{{ color_index }}">
					{%- for value in option.values -%}
						{%- liquid
							assign active = ''
							assign variant_image = blank
							assign variant_url = ''
							assign srcset = ''

							for variant in product.variants
								if variant.title contains value
									if variant.image.id and variant.image.id == product.featured_image.id
										assign active = 'active'
									endif
									if variant.image
										assign variant_image = variant.image
									endif
									assign variant_url = variant.url
								endif
							endfor
							assign image_sizes = sizes | split: ","
						-%}
						{%- capture srcset -%}
							{%- if variant_image != blank -%}
							  {%- for size in image_sizes -%}
							    {%- assign small_size = '20x' -%}
							    {%- assign size_array = size | split: "x" -%}
							    {%- assign size_x = size_array[0] | append: 'x' -%}
							    {% if size_array[1] != "0" %}
							      {%- assign size_x = size -%}
							      {%- assign small_x = size_array[1] | times: 20 | divided_by: size_array[0] | floor -%}
							      {%- assign small_size = small_size | append: small_x -%}
							    {% endif %}
							    {{- variant_image.src | img_url: size_x, crop: 'center' }} {{ size_array[0] }}w,
							  {%- endfor -%}
							{%- endif -%}
						{%- endcapture -%}
						{% assign l = srcset | size | minus: 1 %}
						{%- liquid
							assign color_value = value | downcase | escape

							for custom_color in key_array
								if custom_color == color_value
									assign color_value = val_array[forloop.index0]
								endif
							endfor

							assign bg_value = ''
							if color_value contains '.'
								assign bg_value = color_value | file_url
								assign color_value = 'var(--bg-body)'
							endif

							if value.swatch.image
								assign bg_value = value.swatch.image | image_url: width: variant_image_size
								assign swatch_focal_point = value.swatch.image.presentation.focal_point
							elsif value.swatch.color
								assign color_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
							endif

							if variant_image
								assign bg_value = variant_image | image_url: width: 40
							endif
						-%}
						<input type="radio" id="product-card-{{ product.id }}-{{ option.position }}-{{ forloop.index0 }}"
							name="product-card-{{ product.id }}-{{ option.name | escape }}"
							value="{{ value | escape }}"
							{% if active == 'active' %}checked{% endif %}
							class="product-card-swatch-input"
							data-variant-url="{{ variant_url }}"
							data-srcset="{{- srcset | slice: 0, l | strip_newlines -}}"
						>
						<label for="product-card-{{ product.id }}-{{ option.position }}-{{ forloop.index0 }}" 
							class="{{ active }}" 
							style="--option-color: {{ color_value | downcase | escape }}; {%- if bg_value -%} --option-color-image: url('{{ bg_value | escape }}');{%- endif -%}">
							<span class="visually-hidden">{{ value }}</span>
						</label>
					{%- endfor -%}
				</fieldset>
				<div class="product-card-color-info">{% if current_color != blank %}{{ current_color }}{% else %}{{ active_color_value }}{% endif %} | {{ option.values.size }} Colors</div>
				{%- if swatch_style == 'hover' -%}
					<div class="product-card-swatches--title">{{ 'products.product.available' | t: count: option.values.size }}</div>
				{%- endif -%}
				{%- endif -%}
				{% break %}
			{%- endif -%}
		{%- endfor -%}
		{%- endunless -%}
	{%- endif -%}
{%- endif -%}
